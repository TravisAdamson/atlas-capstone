    font-size: 1.5em;
    margin-bottom: 15px;
}

.Form-group {
    margin-bottom: 15px;
}

label {
    font-weight: bold;
}

.form-control {
    width: 100%;
    padding: 10px;
    font-size: 1em;
    margin-top: 5px;
    border-radius: 5px;
}

.form-check-input {
    margin-top: 10px;
    transform: scale(1.2);
}

.title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.navigation-controls {
    display: flex;
    gap: 10px;
}

.SubmitRecordButton {
    display: flex;
    justify-content: flex-end;
}

.SaveButtonFirst {
    margin-top: 20px;
}

.btn-submit, .btn-secondary {
    padding: 10px 20px;
    color: white;
    font-size: 1em;
    border-radius: 5px;
    border: none;
}

.btn-submit {
    background-color: #936091;
}

.btn-secondary {
    background-color: #6c757d;
}

.SaveButtonFirst button:hover {
