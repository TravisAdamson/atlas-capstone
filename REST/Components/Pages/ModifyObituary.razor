@page "/Obituary"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Obituary</PageTitle>

<div class="title-bar">
    <h1>Modify Obituary Record</h1>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingObituary" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="MilitaryForm">
    <EditForm Model="@editingObituary">
        <h5>Obituary Details</h5>

        <div class="Form-group">
            <label>Distribution Format</label>
            <InputText class="form-control" @bind-Value="editingObituary.DistributionFormat" />
        </div>

        <div class="Form-group">
            <label>Media</label>
            <InputText class="form-control" @bind-Value="editingObituary.Media" />
        </div>

        <div class="Form-group">
            <label>Date Sent</label>
            <InputDate class="form-control" @bind-Value="editingObituary.DateSent" />
        </div>

        <div class="Form-group">
            <label>Primary</label>
            <InputCheckbox class="form-check-input" @bind-Value="editingObituary.Primary" />
        </div>

        <div class="Form-group">
            <label>Include Primary Photo</label>
            <InputCheckbox class="form-check-input" @bind-Value="editingObituary.IncludePrimaryPhoto" />
        </div>

        <div class="Form-group">
            <label>Show Survivor Addresses</label>
            <InputCheckbox class="form-check-input" @bind-Value="editingObituary.ShowSurvivorAddresses" />
        </div>

        <div class="Form-group">
            <label>Show Survivor Relationships</label>
            <InputCheckbox class="form-check-input" @bind-Value="editingObituary.ShowSurvivorRelationships" />
        </div>

        <div class="Form-group">
            <label>Relationship Count</label>
            <InputText class="form-control" @bind-Value="editingObituary.RelationshipCount" />
        </div>

        <div class="Form-group">
            <label>Word Count</label>
            <InputText class="form-control" @bind-Value="editingObituary.WordCount" />
        </div>

        <div class="Form-group">
            <label>Obituary Notes</label>
            <InputTextArea class="form-control" @bind-Value="editingObituary.ObitNotes" />
        </div>

        <div class="Form-group">
            <label>Last Preneed ID</label>
            <InputText class="form-control" @bind-Value="editingObituary.LastPreneedId" />
        </div>

        <div class="Form-group">
            <label>Last Atneed ID</label>
            <InputText class="form-control" @bind-Value="editingObituary.LastAtneedId" />
        </div>

        <div class="Form-group">
            <label>Obituary</label>
            <InputTextArea class="form-control" @bind-Value="editingObituary.Obituary" />
        </div>
    </EditForm>
</div>

@code {
    private List<ObituaryData> obituaryList = new();
    private ObituaryData editingObituary = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        obituaryList = await Context.ObituaryData.ToListAsync();

        if (obituaryList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < obituaryList.Count;
                }
            }

            editingObituary = CloneObituary(currentRecordIndex > 0 ? obituaryList[currentRecordIndex - 1] : obituaryList.Last());
        }
    }

    private ObituaryData CloneObituary(ObituaryData original)
    {
        return new ObituaryData
        {
            Id = original.Id,
            DistributionFormat = original.DistributionFormat,
            Media = original.Media,
            DateSent = original.DateSent,
            Primary = original.Primary,
            IncludePrimaryPhoto = original.IncludePrimaryPhoto,
            ShowSurvivorAddresses = original.ShowSurvivorAddresses,
            ShowSurvivorRelationships = original.ShowSurvivorRelationships,
            RelationshipCount = original.RelationshipCount,
            WordCount = original.WordCount,
            ObitNotes = original.ObitNotes,
            LastPreneedId = original.LastPreneedId,
            LastAtneedId = original.LastAtneedId,
            Obituary = original.Obituary
        };
    }

    private async Task SaveRecord()
    {
        var entity = await Context.ObituaryData.FirstOrDefaultAsync(o => o.Id == editingObituary.Id);
        if (entity is not null)
        {
            entity.DistributionFormat = editingObituary.DistributionFormat;
            entity.Media = editingObituary.Media;
            entity.DateSent = editingObituary.DateSent;
            entity.Primary = editingObituary.Primary;
            entity.IncludePrimaryPhoto = editingObituary.IncludePrimaryPhoto;
            entity.ShowSurvivorAddresses = editingObituary.ShowSurvivorAddresses;
            entity.ShowSurvivorRelationships = editingObituary.ShowSurvivorRelationships;
            entity.RelationshipCount = editingObituary.RelationshipCount;
            entity.WordCount = editingObituary.WordCount;
            entity.ObitNotes = editingObituary.ObitNotes;
            entity.LastPreneedId = editingObituary.LastPreneedId;
            entity.LastAtneedId = editingObituary.LastAtneedId;
            entity.Obituary = editingObituary.Obituary;

            await Context.SaveChangesAsync();
        }
    }
}
