	display: flex;
	flex-wrap: wrap;
	padding-left: .25rem;
}

.numcall1 {
	border: 2px solid rgb(253, 251, 251);
	border-radius: 0.2rem;
	padding: 0.5rem;
	box-sizing: border-box;
