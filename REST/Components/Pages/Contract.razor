	background-color: #e0e0e0;
	border: none;
	padding: 10px 15px;
	border-radius: 5px 5px 0 0;
	font-weight: bold;
	cursor: pointer;
}

.tab-button.active {
	background-color: #936091;
	color: white;
}

.TabForm {
	display: inline-block;
	max-width: 100%;
	background-color: rgb(187, 188, 188);
	border-radius: 5px;
	box-sizing: border-box;
