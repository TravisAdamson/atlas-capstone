@page "/Contract"
@inject RESTDB.Data.ApplicationDbContext Db

@inject NavigationManager NavigationManager

@using RESTDB.Models
@using RESTDB.Migrations
@using RESTDB.Data
@using REST.Components.Shared
@inherits LayoutComponentBase
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components

@using Microsoft.AspNetCore.Components.Web
@inject RESTDB.Data.ApplicationDbContext Db


<PageTitle>Contract Record</PageTitle>

@code {
    private Deceased currentDeceased = new Deceased();
}

<ActiveService 
    Director="@currentDeceased.Director" 
    FirstName="@currentDeceased.FirstName" 
    MiddleName="@currentDeceased.MiddleName"
    LastName="@currentDeceased.LastName"
	Title="@currentDeceased.Title"
	Status="@currentDeceased.Status"
	ContractBalance="@Convert.ToDecimal(currentDeceased.ContractBalance)"
	Photo="@currentDeceased.Image" />

<div class="title-bar">
    <h1>Contract Record</h1>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingContract" OnValidSubmit="SaveContractRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit" style="background-color: #936091;">Save</button>
            </div>
        </EditForm>
    </div>
</div>

    <!-- Main Contract Fields -->
    <EditForm Model="@editingContract">
        <div class="ContractForm">
            <div class="pod-field-container">
                <div class="FirstCall-group1"><label>Contract Date</label><InputDate class="form-control" @bind-Value="editingContract.ContractDate" /></div>
                <div class="FirstCall-group1"><label>Sales Package</label><InputText class="form-control" @bind-Value="editingContract.SalesPackage" /></div>
                <div class="FirstCall-group1"><label>Estate Owner</label><InputText class="form-control" @bind-Value="editingContract.EstateOwner" /></div>
                <div class="FirstCall-group1"><label>Balance</label><InputNumber class="form-control" @bind-Value="editingContract.Balance" /></div>
                <div class="FirstCall-group1"><label>Distributed Charges</label><InputNumber class="form-control" @bind-Value="editingContract.DistributedCharges" /></div>
            </div>
        </div>
    </EditForm>

<!-- Tabs Navigation -->
<div class="TabForm">
    <div class="tab-buttons">
        <button @onclick="@(() => SelectTab("Buyers"))" class="tab-button @(selectedTab == "Buyers" ? "active" : "")">Buyers</button>
        <button @onclick="@(() => SelectTab("Products"))" class="tab-button @(selectedTab == "Products" ? "active" : "")">Products</button>
    </div>
</div>

<!-- Tab Content -->
<div class="Tabinfoform">
<div class="FirstCall-group">
    <div class="FirstCall-group1">
    @if (selectedTab == "Buyers")
    {
        <h5>Buyers</h5>
        <div class="FirstCall-group">
            <label>Name</label>
            <InputText class="fcall" @bind-Value="editingBuyer.Name" />
            <label>Address</label>
            <InputText class="fcall" @bind-Value="editingBuyer.Address" />
            <label>Phone Number</label>
            <InputText class="fcall" @bind-Value="editingBuyer.PhoneNumber" />
            <label>Relationship</label>
            <InputText class="fcall" @bind-Value="editingBuyer.Relationship" />
            <label>Is Primary Buyer</label>
            <InputCheckbox class="fcall" @bind-Value="editingBuyer.IsPrimaryBuyer" />
            <label>Send Bill</label>
            <InputCheckbox class="fcall" @bind-Value="editingBuyer.SendBill" />
        </div>
    }
    else if (selectedTab == "Products")
    {
        <h5>Products</h5>
        <div class="FirstCall-group">
            <label>Category</label>
            <InputText class="fcall" @bind-Value="editingProduct.Category" />
            <label>Item</label>
            <InputText class="fcall" @bind-Value="editingProduct.Item" />
            <label>Tax</label>
            <InputNumber class="fcall" @bind-Value="editingProduct.Tax" />
            <label>Price</label>
            <InputNumber class="fcall" @bind-Value="editingProduct.Price" />
        </div>
    }
    </div>
</div> 
</div>

@code {
    private ServiceContract editingContract = new();
    private Buyer editingBuyer = new();
    private Products editingProduct = new();

    private string selectedTab = "Buyers";

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        var contractList = await Db.ServiceContract.ToListAsync();
        if (contractList.Any())
        {
            editingContract = contractList.First(); // Replace with ID-based logic if needed
        }
    }

    private async Task SaveContractRecord()
    {
        var entity = await Db.ServiceContract.FirstOrDefaultAsync(c => c.Id == editingContract.Id);
        if (entity is not null)
        {
            entity.ContractDate = editingContract.ContractDate;
            entity.SalesPackage = editingContract.SalesPackage;
            entity.EstateOwner = editingContract.EstateOwner;
            entity.Balance = editingContract.Balance;
            entity.DistributedCharges = editingContract.DistributedCharges;

            await Db.SaveChangesAsync();
        }
    }

    private void SelectTab(string tabName)
    {
        selectedTab = tabName;
    }
}



