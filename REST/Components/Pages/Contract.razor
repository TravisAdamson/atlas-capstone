@page "/Contract"

@inject RESTDB.Data.ApplicationDbContext Db
@inject NavigationManager NavigationManager
@inject REST.Services.GlobalState GlobalState

@using RESTDB.Models
@using RESTDB.Migrations
@using RESTDB.Data
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using REST.Components.Shared

@inherits LayoutComponentBase

@rendermode InteractiveServer

@namespace REST.Components

<PageTitle>Contract Record</PageTitle>

<ActiveService
	Director="@editingDeceased.Director"
	ServiceID="@editingDeceased.ServiceID"
	FirstName="@editingDeceased.FirstName"
	MiddleName="@editingDeceased.MiddleName"
	LastName="@editingDeceased.LastName"
	Need="@editingDeceased.Need"
	Status="@editingDeceased.Status"
	ContractBalance="@Convert.ToDecimal(editingDeceased.ContractBalance)"
	Photo="@editingDeceased.Image" />

<div class="title-bar">
	<h1>Contract Record</h1>
	<div class="SubmitRecordButton">
		<EditForm Model="@editingContract" OnValidSubmit="SaveContractRecord">
				<button type="submit" class="btn btn-primary btn-submit" style="background-color: #936091;">Save</button>
		</EditForm>
	</div>
</div>

<!-- Main Contract Fields -->
<EditForm Model="@editingContract">
	<div class="ContractForm">
		<div class="pod-field-container">
			<div class="FirstCall-group1"><label>Contract Date</label><InputDate class="form-control" @bind-Value="editingContract.ContractDate" /></div>
			<div class="FirstCall-group1"><label>Sales Package</label><InputText class="form-control" @bind-Value="editingContract.SalesPackage" /></div>
			<div class="FirstCall-group1"><label>Estate Owner</label><InputText class="form-control" @bind-Value="editingContract.EstateOwner" /></div>
			<div class="FirstCall-group1"><label>Balance</label><InputNumber class="form-control" @bind-Value="editingContract.Balance" /></div>
			<div class="FirstCall-group1"><label>Distributed Charges</label><InputNumber class="form-control" @bind-Value="editingContract.DistributedCharges" /></div>
		</div>
	</div>
</EditForm>

<!-- Tabs Navigation -->
<div class="TabForm">
	<div class="tab-buttons">
		<button @onclick="@(() => SelectTab("Buyers"))" class="tab-button @(selectedTab == "Buyers" ? "active" : "")">Buyers</button>
		<button @onclick="@(() => SelectTab("Products"))" class="tab-button @(selectedTab == "Products" ? "active" : "")">Products</button>
	</div>
</div>

<!-- Tab Content -->
<div class="Tabinfoform">
	<div class="FirstCall-group">
		<div class="FirstCall-group1">
		@if (selectedTab == "Buyers")
		{
			<h5>Buyers</h5>
			<div class="FirstCall-group">
				<div class="FirstCall-group1">
					<label>Name</label>
					<InputText class="fcall" @bind-Value="editingBuyer.Name" />
				</div>
				<div class="FirstCall-group1">
					<label>Address</label>
					<InputText class="fcall" @bind-Value="editingBuyer.Address" />
				</div>
				<div class="FirstCall-group1">
					<label>Phone Number</label>
					<InputText class="fcall" @bind-Value="editingBuyer.PhoneNumber" />
				</div>
				<div class="FirstCall-group1">
					<label>Relationship</label>
					<InputText class="fcall" @bind-Value="editingBuyer.Relationship" />
				</div>
				<div class="primary-buyer">
					<div class="subclass-primary">
						<div>
							<label>Is Primary Buyer</label>
							<InputCheckbox class="fcall" @bind-Value="editingBuyer.IsPrimaryBuyer" />
						</div>
						<div>
							<label>Send Bill</label>
							<InputCheckbox class="fcall" @bind-Value="editingBuyer.SendBill" />
						</div>
					</div>
				</div>
			</div>
		}
		else if (selectedTab == "Products")
		{
			<h5>Products</h5>
			<div class="FirstCall-group">
				<div class="FirstCall-group1">
					<label>Category</label>
					<InputText class="fcall" @bind-Value="editingProducts.Category" />
				</div>
				<div class="FirstCall-group1">
					<label>Item</label>
					<InputText class="fcall" @bind-Value="editingProducts.Item" />
				</div>
				<div class="FirstCall-group1">
					<label>Tax</label>
					<InputNumber class="fcall" @bind-Value="editingProducts.Tax" />
				</div>
				<div class="FirstCall-group1">
					<label>Price</label>
					<InputNumber class="fcall" @bind-Value="editingProducts.Price" />
				</div>
			</div>
		}
		else if (selectedTab == "Services")
		{
			<h5>Services</h5>
			<div class="FirstCall-group">
				<div class="FirstCall-group1">
					<label>Category</label>
					<InputText class="fcall" @bind-Value="editingServices.Category" />
				</div>
				<div class="FirstCall-group1">
					<label>Item</label>
					<InputText class="fcall" @bind-Value="editingServices.Item" />
				</div>
				<div class="FirstCall-group1">
					<label>Tax</label>
					<InputNumber class="fcall" @bind-Value="editingServices.Tax" />
				</div>
				<div class="FirstCall-group1">
					<label>Price</label>
					<InputNumber class="fcall" @bind-Value="editingServices.Price" />
				</div>
			</div>
		}
		</div>
	</div>
</div>

@code {
	private List<ServiceContract> contractList = new List<ServiceContract>();
	private ServiceContract currentContract = new ServiceContract();
	private ServiceContract editingContract = new ServiceContract();
	private List<Buyer> buyerList = new List<Buyer>();
	private Buyer currentBuyer = new Buyer();
	private Buyer editingBuyer = new Buyer();
	private List<Products> productsList = new List<Products>();
	private Products currentProducts = new Products();
	private Products editingProducts = new Products();
	private List<Services> servicesList = new List<Services>();
	private Services currentServices = new Services();
	private Services editingServices = new Services();
	private List<Deceased> deceasedList = new List<Deceased>();
	private Deceased currentDeceased = new Deceased();
	private Deceased editingDeceased = new Deceased();
	private string selectedTab = "Buyers";

	protected override async Task OnInitializedAsync()
	{
		// load data
		contractList = await Db.ServiceContract.ToListAsync();
		deceasedList = await Db.Deceased.ToListAsync();
		productsList = await Db.Products.ToListAsync();
		servicesList = await Db.Services.ToListAsync();
		buyerList = await Db.Buyer.ToListAsync();

		// if the user hasn't selected a record yet, send them back.         protective and possibly redundant
		if (GlobalState.ClientID <= 0)
		{
			NavigationManager.NavigateTo("/Search%20Records");
			return;
		}

		// pick out each record by ClientID
		editingDeceased = deceasedList
			.FirstOrDefault(d => d.ClientID == GlobalState.ClientID)
			?? new Deceased();

		editingContract = contractList
			.FirstOrDefault(c => c.ClientID == GlobalState.ClientID)
			?? new ServiceContract();

		editingBuyer = buyerList
			.FirstOrDefault(b => b.ClientID == GlobalState.ClientID)
			?? new Buyer();

		editingServices = servicesList
			.FirstOrDefault(s => s.ClientID == GlobalState.ClientID)
			?? new Services();

		editingProducts = productsList
			.FirstOrDefault(p => p.ClientID == GlobalState.ClientID)
			?? new Products();
	}

	private Deceased CloneDeceased(Deceased original)
	{
		return new Deceased
		{
			ClientID = original.ClientID,
			ServiceID = original.ServiceID,
			Director = original.Director,
			FirstName = original.FirstName,
			LastName = original.LastName,
			MiddleName = original.MiddleName,
			Title = original.Title,
			Suffix = original.Suffix,
			Need = original.Need,
			Status = original.Status,
			StreetAddress = original.StreetAddress,
			City = original.City,
			State = original.State,
			ZipCode = original.ZipCode,
			ContractBalance = original.ContractBalance,
			DoD = original.DoD,
			TimeOfDeath = original.TimeOfDeath,
			SSN = original.SSN,
			Gender = original.Gender,
			MaidenName = original.MaidenName,
			Alias = original.Alias,
			Vet = original.Vet,
			War = original.War,
			InformantName = original.InformantName,
			IStreetAddress = original.IStreetAddress,
			ICity = original.ICity,
			IState = original.IState,
			IZipCode = original.IZipCode,
			IPhoneNumber = original.IPhoneNumber,
			InformantEmail = original.InformantEmail,
			InfoNotified = original.InfoNotified,
			Notes = original.Notes,
			Image = original.Image,
			InformantRelation = original.InformantRelation,
			DoB = original.DoB,
			Age = original.Age,
			BCity = original.BCity,
			BZip = original.BZip,
			BCounty = original.BCounty,
			BState = original.BState,
			BCountry = original.BCountry,
			MStatus = original.MStatus,
			MDate = original.MDate,
			MPlace = original.MPlace,
			Church = original.Church,
			RPreference = original.RPreference,
			Clergy = original.Clergy,
			HighSchool = original.HighSchool,
			HYoE = original.HYoE,
			HEL = original.HEL,
			College = original.College,
			CYoE = original.CYoE,
			CEL = original.CEL
		};
	}

	private ServiceContract CloneContract(ServiceContract original)
	{
		return new ServiceContract
		{
			ClientID = original.ClientID,
			ContractDate = original.ContractDate,
			SalesPackage = original.SalesPackage,
			EstateOwner = original.EstateOwner,
			Balance = original.Balance,
			DistributedCharges = original.DistributedCharges
		};
	}

	private Buyer CloneBuyer(Buyer original)
	{
		return new Buyer
		{
			ClientID = original.ClientID,
			Name = original.Name,
			Address = original.Address,
			PhoneNumber = original.PhoneNumber,
			Relationship = original.Relationship,
			IsPrimaryBuyer = original.IsPrimaryBuyer,
			SendBill = original.SendBill
		};
	}

	private Services CloneServices(Services original)
	{
		return new Services
		{
			ClientID = original.ClientID,
			Category = original.Category,
			Item = original.Item,
			Tax = original.Tax,
			Price = original.Price
		};
	}

	private Products CloneProducts(Products original)
	{
		return new Products
		{
			ClientID = original.ClientID,
			Category = original.Category,
			Item = original.Item,
			Tax = original.Tax,
			Price = original.Price
		};
	}

	private async Task SaveContractRecord()
	{
		var entityC = await Db.ServiceContract.FirstOrDefaultAsync(c => c.ClientID == editingContract.ClientID);
		if (entityC is not null)
		{
			entityC.ContractDate = editingContract.ContractDate;
			entityC.SalesPackage = editingContract.SalesPackage;
			entityC.EstateOwner = editingContract.EstateOwner;
			entityC.Balance = editingContract.Balance;
			entityC.DistributedCharges = editingContract.DistributedCharges;
		}
		var entityB = await Db.Buyer.FirstOrDefaultAsync(b => b.ClientID == editingBuyer.ClientID);
		if (entityB is not null)
		{
			entityB.ClientID = editingBuyer.ClientID;
			entityB.Name = editingBuyer.Name;
			entityB.Address = editingBuyer.Address;
			entityB.PhoneNumber = editingBuyer.PhoneNumber;
			entityB.Relationship = editingBuyer.Relationship;
			entityB.IsPrimaryBuyer = editingBuyer.IsPrimaryBuyer;
			entityB.SendBill = editingBuyer.SendBill;
		}
		var entityS = await Db.Services.FirstOrDefaultAsync(s => s.ClientID == editingServices.ClientID);
		if (entityS is not null)
		{
			entityS.ClientID = editingServices.ClientID;
			entityS.Category = editingServices.Category;
			entityS.Item = editingServices.Item;
			entityS.Tax = editingServices.Tax;
			entityS.Price = editingServices.Price;
		}
		var entityP = await Db.Products.FirstOrDefaultAsync(p => p.ClientID == editingProducts.ClientID);
		if (entityP is not null)
		{
			entityP.ClientID = editingProducts.ClientID;
			entityP.Category = editingProducts.Category;
			entityP.Item = editingProducts.Item;
			entityP.Tax = editingProducts.Tax;
			entityP.Price = editingProducts.Price;
		}
		await Db.SaveChangesAsync();
	}

	private void SelectTab(string tabName)
	{
		selectedTab = tabName;
	}
}

<style>
