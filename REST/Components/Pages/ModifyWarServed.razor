@page "/ModifyWarServed"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Modify War Served</PageTitle>

<div class="title-bar">
    <h1>Modify War Served</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingWarServed" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="WarServedForm">
    <EditForm Model="@editingWarServed">
        <h5>War Served Information</h5>

        <div class="Form-group">
            <label>War Name</label>
            <InputText class="form-control" @bind-Value="editingWarServed.WarName" />
        </div>

        <div class="Form-group">
            <label>Description</label>
            <InputText class="form-control" @bind-Value="editingWarServed.Description" />
        </div>

        <div class="Form-group">
            <label>War Military ID</label>
            <InputText class="form-control" @bind-Value="WarMilitaryIdString" />
        </div>



    </EditForm>
</div>

@code {
    private List<WarsServed> warServedList = new();
    private WarsServed editingWarServed = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        warServedList = await Context.WarsServed.ToListAsync();

        if (warServedList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < warServedList.Count;
                }
            }

            editingWarServed = CloneWarServed(currentRecordIndex > 0 ? warServedList[currentRecordIndex - 1] : warServedList.Last());
        }
    }

    private WarsServed CloneWarServed(WarsServed original)
    {
        return new WarsServed
        {
            Id = original.Id,
            WarName = original.WarName,
            Description = original.Description,
            WarMilitaryId = original.WarMilitaryId,
            Military = original.Military
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingWarServed = warServedList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < warServedList.Count)
        {
            currentRecordIndex++;
            editingWarServed = warServedList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < warServedList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        var entity = await Context.WarsServed.FirstOrDefaultAsync(w => w.Id == editingWarServed.Id);
        if (entity is not null)
        {
            entity.WarName = editingWarServed.WarName;
            entity.Description = editingWarServed.Description;
            entity.WarMilitaryId = editingWarServed.WarMilitaryId;
            entity.Military = editingWarServed.Military;

            await Context.SaveChangesAsync();
        }
    }
    private string WarMilitaryIdString
    {
        get => editingWarServed.WarMilitaryId ?? string.Empty;
        set
        {
            if (int.TryParse(value, out int result))
                editingWarServed.WarMilitaryId = result.ToString(); // ← FIXED HERE
            else
                editingWarServed.WarMilitaryId = null;
        }
    }



}

