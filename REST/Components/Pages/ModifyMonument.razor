@page "/ModifyMonument"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Modify Monument</PageTitle>

<div class="title-bar">
    <h1>Modify Monument Record</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingMonument" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="MilitaryForm">
    <EditForm Model="@editingMonument">
        <h5>Monument Information</h5>

        <div class="Form-group">
            <label>Monument Type</label>
            <InputText class="form-control" @bind-Value="editingMonument.MonumentType" />
        </div>

        <div class="Form-group">
            <label>Material</label>
            <InputText class="form-control" @bind-Value="editingMonument.Material" />
        </div>

        <div class="Form-group">
            <label>Engraving</label>
            <InputTextArea class="form-control" @bind-Value="editingMonument.Engraving" />
        </div>

        <div class="Form-group">
            <label>Created At</label>
            <InputDate class="form-control" @bind-Value="editingMonument.CreatedAt" />
        </div>
    </EditForm>
</div>

@code {
    private List<Monument> monumentList = new();
    private Monument editingMonument = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        monumentList = await Context.Monument.ToListAsync();

        if (monumentList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < monumentList.Count;
                }
            }

            editingMonument = CloneMonument(currentRecordIndex > 0 ? monumentList[currentRecordIndex - 1] : monumentList.Last());
        }
    }

    private Monument CloneMonument(Monument original)
    {
        return new Monument
        {
            Id = original.Id,
            MonumentType = original.MonumentType,
            Material = original.Material,
            Engraving = original.Engraving,
            CreatedAt = original.CreatedAt
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingMonument = monumentList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < monumentList.Count)
        {
            currentRecordIndex++;
            editingMonument = monumentList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < monumentList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        var entity = await Context.Monument.FirstOrDefaultAsync(m => m.Id == editingMonument.Id);
        if (entity is not null)
        {
            entity.MonumentType = editingMonument.MonumentType;
            entity.Material = editingMonument.Material;
            entity.Engraving = editingMonument.Engraving;
            entity.CreatedAt = editingMonument.CreatedAt;

            await Context.SaveChangesAsync();
        }
    }
}
<style>
.MilitaryForm {
    max-width: 100%;
    margin: 20px;
    padding: 20px;
    background-color: #f4f7fc;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

h5 {
    font-size: 1.5em;
    margin-bottom: 15px;
}

.Form-group {
    margin-bottom: 15px;
}

label {
    font-weight: bold;
}

.form-control {
    width: 100%;
    padding: 10px;
    font-size: 1em;
    margin-top: 5px;
    border-radius: 5px;
}

.title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.navigation-controls {
    display: flex;
    gap: 10px;
}

.SubmitRecordButton {
    display: flex;
    justify-content: flex-end;
}

.SaveButtonFirst {
    margin-top: 20px;
}

.btn-submit, .btn-secondary {
    padding: 10px 20px;
    color: white;
    font-size: 1em;
    border-radius: 5px;
    border: none;
}

.btn-submit {
    background-color: #936091;
}

.btn-secondary {
    background-color: #6c757d;
}

.SaveButtonFirst button:hover {
    cursor: pointer;
}
</style>
