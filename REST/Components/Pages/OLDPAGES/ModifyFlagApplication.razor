@page "/ModifyFlagApplication"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Modify Flag Application</PageTitle>

<div class="title-bar">
    <h1>Modify Flag Application Record</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingFlagApplication" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="FlagApplicationForm">
    <EditForm Model="@editingFlagApplication">
        <h5>Flag Application Information</h5>

        <div class="Form-group">
            <label>Applicant Name</label>
            <InputText class="form-control" @bind-Value="editingFlagApplication.ApplicantName" />
        </div>

        <div class="Form-group">
            <label>Relationship to Deceased</label>
            <InputText class="form-control" @bind-Value="editingFlagApplication.RelationshipToDeceased" />
        </div>

        <div class="Form-group">
            <label>Flag Type</label>
            <InputText class="form-control" @bind-Value="editingFlagApplication.FlagType" />
        </div>

        <div class="Form-group">
            <label>Application Date</label>
            <InputDate class="form-control" @bind-Value="editingFlagApplication.ApplicationDate" />
        </div>
    </EditForm>
</div>

@code {
    private List<FlagApplication> flagAppList = new();
    private FlagApplication editingFlagApplication = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        flagAppList = await Context.FlagApplication.ToListAsync();

        if (flagAppList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < flagAppList.Count;
                }
            }

            editingFlagApplication = CloneFlagApplication(currentRecordIndex > 0 ? flagAppList[currentRecordIndex - 1] : flagAppList.Last());
        }
    }

    private FlagApplication CloneFlagApplication(FlagApplication original)
    {
        return new FlagApplication
        {
            Id = original.Id,
            ApplicantName = original.ApplicantName,
            RelationshipToDeceased = original.RelationshipToDeceased,
            FlagType = original.FlagType,
            ApplicationDate = original.ApplicationDate
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingFlagApplication = flagAppList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < flagAppList.Count)
        {
            currentRecordIndex++;
            editingFlagApplication = flagAppList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < flagAppList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        var entity = await Context.FlagApplication.FirstOrDefaultAsync(f => f.Id == editingFlagApplication.Id);
        if (entity is not null)
        {
            entity.ApplicantName = editingFlagApplication.ApplicantName;
            entity.RelationshipToDeceased = editingFlagApplication.RelationshipToDeceased;
            entity.FlagType = editingFlagApplication.FlagType;
            entity.ApplicationDate = editingFlagApplication.ApplicationDate;

            await Context.SaveChangesAsync();
        }
    }
}
