@page "/ModifyContainerShipping"
@inject RESTDB.Data.ApplicationDbContext Context
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Modify Container Shipping</PageTitle>

<div class="title-bar">
    <h1>Modify Container Shipping</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary" style="background-color: #936091;">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary" style="background-color: #936091;">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingContainerShipping" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit" style="background-color: #936091;">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="ContainerShippingForm">
    <EditForm Model="@editingContainerShipping">
        <h5>Container Shipping Information</h5>
        <div class="Form-group">
            <label>Ship From</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipFrom" />
        </div>
        <div class="Form-group">
            <label>Ship To</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipTo" />
        </div>
        <div class="Form-group">
            <label>Ship To Name</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipToName" />
        </div>
        <div class="Form-group">
            <label>Ship From Name</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipFromName" />
        </div>
        <div class="Form-group">
            <label>Ship From Street</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipFromStreet" />
        </div>
        <div class="Form-group">
            <label>Ship From Zip</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipFromZip" />
        </div>
        <div class="Form-group">
            <label>Ship From Township</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipFromTownship" />
        </div>
        <div class="Form-group">
            <label>Ship From Locality</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipFromLocality" />
        </div>
        <div class="Form-group">
            <label>Ship From State</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipFromState" />
        </div>
        <div class="Form-group">
            <label>Ship From Country</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipFromCountry" />
        </div>
        <div class="Form-group">
            <label>Ship From County</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipFromCounty" />
        </div>
        <div class="Form-group">
            <label>Ship To Street</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipToStreet" />
        </div>
        <div class="Form-group">
            <label>Ship To Zip</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipToZip" />
        </div>
        <div class="Form-group">
            <label>Ship To Township</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipToTownship" />
        </div>
        <div class="Form-group">
            <label>Ship To Locality</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipToLocality" />
        </div>
        <div class="Form-group">
            <label>Ship To State</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipToState" />
        </div>
        <div class="Form-group">
            <label>Ship To Country</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipToCountry" />
        </div>
        <div class="Form-group">
            <label>Ship To County</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.ShipToCounty" />
        </div>
        <div class="Form-group">
            <label>Notes</label>
            <InputText class="form-control" @bind-Value="editingContainerShipping.Notes" />
        </div>
    </EditForm>
</div>

@code {
    private List<ContainerShipping> containerShippingList = new();
    private ContainerShipping editingContainerShipping = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        containerShippingList = await Context.ContainerShipping.ToListAsync();

        if (containerShippingList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < containerShippingList.Count;
                }
            }

            editingContainerShipping = CloneContainerShipping(currentRecordIndex > 0 ? containerShippingList[currentRecordIndex - 1] : containerShippingList.Last());
        }
    }

    private ContainerShipping CloneContainerShipping(ContainerShipping original)
    {
        return new ContainerShipping
        {
            Id = original.Id,
            ShipFrom = original.ShipFrom,
            ShipTo = original.ShipTo,
            ShipToName = original.ShipToName,
            ShipFromName = original.ShipFromName,
            ShipFromStreet = original.ShipFromStreet,
            ShipFromZip = original.ShipFromZip,
            ShipFromTownship = original.ShipFromTownship,
            ShipFromLocality = original.ShipFromLocality,
            ShipFromState = original.ShipFromState,
            ShipFromCountry = original.ShipFromCountry,
            ShipFromCounty = original.ShipFromCounty,
            ShipToStreet = original.ShipToStreet,
            ShipToZip = original.ShipToZip,
            ShipToTownship = original.ShipToTownship,
            ShipToLocality = original.ShipToLocality,
            ShipToState = original.ShipToState,
            ShipToCountry = original.ShipToCountry,
            ShipToCounty = original.ShipToCounty,
            Notes = original.Notes
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingContainerShipping = containerShippingList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < containerShippingList.Count)
        {
            currentRecordIndex++;
            editingContainerShipping = containerShippingList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < containerShippingList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        if (string.IsNullOrWhiteSpace(editingContainerShipping.ShipFrom))
        {
            Console.WriteLine("Ship From is required.");
            return;
        }

        var entity = await Context.ContainerShipping.FirstOrDefaultAsync(a => a.Id == editingContainerShipping.Id);
        if (entity is not null)
        {
            entity.ShipFrom = editingContainerShipping.ShipFrom;
            entity.ShipTo = editingContainerShipping.ShipTo;
            entity.ShipToName = editingContainerShipping.ShipToName;
            entity.ShipFromName = editingContainerShipping.ShipFromName;
            entity.ShipFromStreet = editingContainerShipping.ShipFromStreet;
            entity.ShipFromZip = editingContainerShipping.ShipFromZip;
            entity.ShipFromTownship = editingContainerShipping.ShipFromTownship;
            entity.ShipFromLocality = editingContainerShipping.ShipFromLocality;
            entity.ShipFromState = editingContainerShipping.ShipFromState;
            entity.ShipFromCountry = editingContainerShipping.ShipFromCountry;
            entity.ShipFromCounty = editingContainerShipping.ShipFromCounty;
            entity.ShipToStreet = editingContainerShipping.ShipToStreet;
            entity.ShipToZip = editingContainerShipping.ShipToZip;
            entity.ShipToTownship = editingContainerShipping.ShipToTownship;
            entity.ShipToLocality = editingContainerShipping.ShipToLocality;
            entity.ShipToState = editingContainerShipping.ShipToState;
            entity.ShipToCountry = editingContainerShipping.ShipToCountry;
            entity.ShipToCounty = editingContainerShipping.ShipToCounty;
            entity.Notes = editingContainerShipping.Notes;

            await Context.SaveChangesAsync();
        }
    }
}

<style>
/* ContainerShippingForm */
.ContainerShippingForm {
    max-width: 100%;
    margin: 20px;
    padding: 20px;
    background-color: #f4f7fc;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

h5 {
    font-size: 1.5em;
    margin-bottom: 15px;
}

.Form-group {
    margin-bottom: 15px;
}

label {
    font-weight: bold;
}

.form-control {
    width: 100%;
    padding: 10px;
    font-size: 1em;
    margin-top: 5px;
    border-radius: 5px;
}

.title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.navigation-controls {
    display: flex;
    gap: 10px;
}

.SubmitRecordButton {
    display: flex;
    justify-content: flex-end;
}

.SaveButtonFirst {
    margin-top: 20px;
}

.btn-submit, .btn-secondary {
    padding: 10px 20px;
    color: white;
    font-size: 1em;
    border-radius: 5px;
    border: none;
}

.btn-submit {
    background-color: #936091;
}

.btn-secondary {
    background-color: #6c757d;
}

.SaveButtonFirst {
    margin-top: 20px;
}

.SaveButtonFirst button:hover {
    cursor: pointer;
}
</style>