		background-color: #c7a5e9;
		height: 60px;
		width: 150px;
		z-index: 1000;
	}

	h1 {
		text-align: center;
		padding-top: 1rem;
	}

	.logo-image-container {
		text-align: center;
		margin-top: 2rem;
		padding-top: 6rem;
	}

	.the-actual-image {
