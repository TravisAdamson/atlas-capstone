@page "/"

<PageTitle>Home</PageTitle>

<h1>Start Page</h1>

<div>
    <div>
        <!-- Search -->
        <span class="label">Search</span>
        <input
            class="searchbar"
            type="text"
            placeholder="Search"
            @bind="searchText"
            @oninput="Search"
            />
    </div>

    <!-- Link tab -->
    <div class="homebuttons">
        <button class="btn">Create service records</button>
        <button class="btn">First Call</button>
        <button class="btn">Create Death Certifficate</button>
        <button class="btn">Import Death Certifficate</button>
        <button class="btn">Schedule Service</button>
        <button class="btn">View All Records</button>
        <button class="btn">Contract</button>
    </div>
</div>

@code {
    private string searchText = string.Empty;

    private void Search()
    {
        Console.WriteLine(searchText);
    }
}