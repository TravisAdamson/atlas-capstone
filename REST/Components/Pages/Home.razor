@page "/"
@using System.Security.Claims

<PageTitle>Home</PageTitle>

<div>
	<h1>Start Page</h1>

	<!-- Link tab -->
	<div class="homebuttons">
		<button class="btn" onclick="window.location.href='First Call'">First Call</button>
		<button class="btn" onclick="window.location.href='Search Records'">Modify Records</button>
