        padding-top: 3rem;
        flex-wrap: wrap;
    }

    .btn {
        padding: 1rem 1rem;
        font-size: 1rem;
        border-radius: 4px;
        cursor: pointer;
        border-color: #000000;
        background-color: #c7a5e9;
        height: 60px;
        width: 150px;
        z-index: 1000;
    }

    h1 {
        text-align: center;
        padding-top: 1rem;
