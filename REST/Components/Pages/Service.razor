@page "/First Call"

<PageTitle>First Call</PageTitle>

<div class="forms">
    <div class="form1">
        <!-- FirstCall -->
        <div class="FirstCall-group">
            <div class="FirstCall-group1">
                <label for="client-id">Client ID</label>
                <input id="client-id" class="clientid" type="text" name="client-id" />
            </div>
            <div class="FirstCall-group1">
                <label for="director">Director</label>
                <input id="director" class="director" type="text" name="director" />
            </div>
        </div>

        <!-- Name Info -->
        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="last-name">Last Name</label>
                <input id="last-name" class="director" type="text" name="last-name" />
            </div>
            <div class="FirstCall-group1">
                <label for="first-name">First Name</label>
                <input id="first-name" class="director" type="text" name="first-name" />
            </div>
            <div class="FirstCall-group1">
                <label for="middle-name">Middle Name</label>
                <input id="middle-name" class="director" type="text" name="middle-name" />
            </div>
            <div class="FirstCall-group1">
                <label for="suffix">Suffix</label>
                <select id="suffix" name="suffix">
                    <option value="mr">Mr.</option>
                    <option value="ms">Ms.</option>
                    <option value="dr">Dr.</option>
                </select>
            </div>
        </div>

        <!-- Display Name -->
        <div class="display-name">
            <div class="FirstCall-group1">
                <label for="display">Display Name</label>
                <input id="display" class="displayname" type="text" name="display" />
            </div>
        </div>

        <!-- Display Image -->
        <div class="display-img">
            <div>
                <img class="img-class">
            </div>
        </div>
    </div>

    <!-- Deceased -->
    <div class="form2">
        <h5>Deceased</h5>
        <div>
            <div>
                <label for="death date">Death Date </label>
                <input
                    id="death date"
                    />
            </div>
            <div>
                <label for="time">Time</label>
                <input
                    type="number"
                    id="time"
                    placeholder="_:__"
                    />
            </div>
            <div>
                <label for="snn">Social Security Number</label>
                <input
                    type="number"
                    id="ssn"
                    name="ssn"
                    placeholder="123-45-6789"
                    maxlength="11"
                    />
            </div>

            <!-- Sex -->
            <div>
                <label>Sex</label>
                <input type="radio" name="gender" value="Male" /> Male
                <input type="radio" name="gender" value="Female" /> Female
                <input type="radio" name="gender" value="Other" /> Other
            </div>
        </div>
        <div>
            <div>
                <label for="display name">Street Address</label>
                <input
                    id="display"
                    class="displayname"
                    type="text"
                    name="display"
                />
            </div>

            <div>
                <label for="display name">Zip</label>
                <input
                    id="display"
                    class="displayname"
                    type="text"
                    name="display"
                />
            </div>

            <div>
                <label for="display name">City</label>
                <input
                    id="display"
                    class="displayname"
                    type="text"
                    name="display"
                />
            </div>

            <div>
                <label for="display name">County</label>
                <input
                    id="display"
                    class="displayname"
                    type="text"
                    name="display"
                />
            </div>
        </div>

        <!-- State row -->
        <div>
            <label for="state">State</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>

        <div>
            <label for="state">Country</label>
            <input
                id="country"
                class="country1"
                type="text"
                name="country"
            />
        </div>

        <div>
            <label for="state">Locality Type</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>
        <div>
            <label for="state">Home City</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>
        <div>
            <label for="state">Home State</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>
        <div>
            <label for="state">Previous State</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>

        <div>
            <label for="state">Phone Number</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>

        <div>
            <label for="state">Veteran</label>
            <input
                id="state"
            />
        </div>

        <div>
            <label for="state">War Served</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>
        <div>
            <label for="state">Informant</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>

        <div>
            <label for="state">OriginType</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>

        <div>
            <label for="state">Date Information</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>

        <div>
            <label for="state">date Amended</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>

        <div>
            <label for="state">EmailAddress</label>
            <input
                id="state"
                class="state1"
                type="text"
                name="state"
            />
        </div>
        <div>
            <button>
                Save
            </button>
        </div>
    </div>
</div>
