@page "/Search Records"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Search Records</PageTitle>

<h1>Search Records</h1>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Date of Death</th>
            <th>Time of Death</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var deceased in Deceased)
        {
            <tr>
                <td>@deceased.FirstName</td>
                <td>@deceased.LastName</td>
                <td>@deceased.DoD?.ToString("MM-dd-yyyy")</td>
				<td>@deceased.TimeOfDeath?.ToString("hh:mm tt")</td>
                <td>
                    <button @onclick="() => StartEdit(deceased.ClientID ?? -1)">Edit</button>
                    
                    @if (ConfirmingDeleteId == deceased.ClientID)
                    {
                        <div>
                            <button class="btn btn-danger mt-1" @onclick="() => ConfirmDelete(deceased.ClientID ?? -1)">Confirm Delete</button>
                        </div>
                    }
                    else
                    {
                        <button class= "@onclick="() => ShowConfirmDelete(deceased.ClientID ?? -1)">Delete</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


@code {
    private List<RESTDB.Models.Deceased> Deceased = new List<RESTDB.Models.Deceased>();

    protected override async Task OnInitializedAsync()
    {
        Deceased = await Context.Deceased.ToListAsync();
    }

    private void StartEdit(int clientID)
    {
        // Navigate to the Modify Records page with the ClientID as a query parameter
        NavigationManager.NavigateTo($"/Modify%20Records?currentRecordString={clientID}");
    }

    private async Task DeleteDeceased(int clientId)
    {
        var deceasedToDelete = await Context.Deceased.FirstOrDefaultAsync(d => d.ClientID == clientId);
        if (deceasedToDelete != null)
        {
            Context.Deceased.Remove(deceasedToDelete);
            await Context.SaveChangesAsync();
            Deceased = await Context.Deceased.ToListAsync();
        }
    }
    private int? ConfirmingDeleteId = null;

    <!--  --------------------------------------------------- -->
    private void ShowConfirmDelete(int clientId)
    {
        ConfirmingDeleteId = clientId;
    }

    private async Task ConfirmDelete(int clientId)
    {
        var deceasedToDelete = await Context.Deceased.FirstOrDefaultAsync(d => d.ClientID == clientId);
        if (deceasedToDelete != null)
        {
            Context.Deceased.Remove(deceasedToDelete);
            await Context.SaveChangesAsync();
            Deceased = await Context.Deceased.ToListAsync();
        }

        ConfirmingDeleteId = null; // Reset after deletion
    }

}