@page "/Search Records"

@inject ApplicationDbContext Db
@inject NavigationManager NavigationManager
@inject UserState UserState

@rendermode InteractiveServer

<h3>Search Deceased Records</h3>

<form @onsubmit="HandleSubmit">
	<div class="mb-3">
		<label>Select Field:</label>
		<select @bind="selectedField" class="form-select">
			@foreach (var field in searchFields)
			{
				<option value="@field.Value">@field.Key</option>
			}
		</select>
	</div>
	<div class="mb-3">
		<input type="text" @bind="searchTerm" placeholder="Enter search term..." class="form-control" />
	</div>
	<button type="submit" class="btn btn-submit btn-primary" style="background-color: #936091; color: white; border: none">Search</button>
</form>

@if (isLoading)
{
	<p><em>Loading...</em></p>
}
else if (results != null && results.Any())
{
	<table class="table table-striped mt-3">
		<thead>
			<tr>
				<th>Service ID</th>
				<th>First Name</th>
				<th>Last Name</th>
				<th>Director</th>
				<th>City</th>
				<th>DoD</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in results)
			{
				<tr>
					<td>@item.ServiceID</td>
					<td>@item.FirstName</td>
					<td>@item.LastName</td>
					<td>@item.Director</td>
					<td>@item.City</td>
					<td>@item.DoD?.ToString("MM-dd-yyyy")</td>
					<td>
						<button type="button" @onclick="() => StartEdit(item.ServiceID ?? null)">Edit</button>
						<span class="Spacing"></span>
						@if (ConfirmingDeleteId == @item.ServiceID)
						{
							<div class="mt-1">
								<button type="button" class="btn btn-danger me-2" @onclick="() => ConfirmDelete(item.ServiceID ?? null)">Confirm Delete</button>
								<button type="button" class="btn btn-success" @onclick="CancelDelete">Cancel</button>
							</div>
						}
						else
						{
							<button type="button" @onclick="() => ShowConfirmDelete(item.ServiceID ?? null)">Delete</button>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else if (searched)
{
	<p class="mt-3"><em>No results found.</em></p>
}

@code {
	private string searchTerm = string.Empty;
	private string selectedField = "FirstName";
	private List<Deceased> results = new();
	private Deceased deceased = new Deceased();
	private bool isLoading = false;
	private bool searched = false;
	private string? ConfirmingDeleteId = null;
	private Dictionary<string, string> searchFields = new()
	{
		{ "First Name", "FirstName" },
		{ "Last Name", "LastName" },
		{ "City", "City" },
		{ "Director", "Director" },
		{ "Status", "Status" },
		{ "SSN", "SSN" },
		{ "Gender", "Gender" },
		{ "Maiden Name", "MaidenName" },
		{ "Buyer's Name", "Buyer.Name"}
	};
	private async Task HandleSubmit()
	{
		await Search();
	}

	private async Task Search()
	{
		isLoading = true;
		searched = false;

		IQueryable<Deceased> query = Db.Deceased
				.Include(d => d.Airline)
				.Include(d => d.Buyer)
				.Include(d => d.CashAdvance)
				.Include(d => d.CauseOfDeath)
				.Include(d => d.ContainerShipping)
				.Include(d => d.Embalmer)
				.Include(d => d.FlagApplication)
				.Include(d => d.Military)
				.Include(d => d.MilitaryStint)
				.Include(d => d.Monument)
				.Include(d => d.ObituaryData)
				.Include(d => d.PlaceOfDeath)
				.Include(d => d.Products)
				.Include(d => d.ServiceContract)
				.Include(d => d.Services)
				.Include(d => d.Survivors)
				.Include(d => d.WarsServed);

		if (!string.IsNullOrWhiteSpace(searchTerm))
		{
			query = selectedField switch
			{
				"FirstName" => query.Where(d => d.FirstName != null && d.FirstName.Contains(searchTerm)),
				"LastName" => query.Where(d => d.LastName != null && d.LastName.Contains(searchTerm)),
				"City" => query.Where(d => d.City != null && d.City.Contains(searchTerm)),
				"Director" => query.Where(d => d.Director != null && d.Director.Contains(searchTerm)),
				"Status" => query.Where(d => d.Status != null && d.Status.Contains(searchTerm)),
				"SSN" => query.Where(d => d.SSN != null && d.SSN.Contains(searchTerm)),
				"Gender" => query.Where(d => d.Gender != null && d.Gender.Contains(searchTerm)),
				"MaidenName" => query.Where(d => d.MaidenName != null && d.MaidenName.Contains(searchTerm)),
				"Buyer.Name" => query.Where(d => d.Buyer.Any(b => b.Name != null && b.Name.Contains(searchTerm))),
				_ => query
			};
		}
		query = query.OrderByDescending(d => d.DoD);
		results = await query.ToListAsync();
		isLoading = false;
		searched = true;
	}

	private void StartEdit(string ServiceID)
	{
		UserState.ServiceID = ServiceID;
		Console.WriteLine($"ClientID: {UserState.ServiceID}");
		NavigationManager.NavigateTo("/Modify%20Records");
	}

	private void ShowConfirmDelete(string ServiceID)
	{
		ConfirmingDeleteId = ServiceID;
	}

	private void CancelDelete()
	{
		ConfirmingDeleteId = null;
	}

	private async Task ConfirmDelete(string DeleteID)
	{
		deceased = await Db.Deceased
			.Include(d => d.Airline)
			.Include(d => d.Buyer)
			.Include(d => d.CashAdvance)
			.Include(d => d.CauseOfDeath)
			.Include(d => d.ContainerShipping)
			.Include(d => d.Embalmer)
			.Include(d => d.FlagApplication)
			.Include(d => d.Military)
			.Include(d => d.MilitaryStint)
			.Include(d => d.Monument)
			.Include(d => d.ObituaryData)
			.Include(d => d.PlaceOfDeath)
			.Include(d => d.Products)
			.Include(d => d.ServiceContract)
			.Include(d => d.Services)
			.Include(d => d.Survivors)
			.Include(d => d.WarsServed)
			.FirstOrDefaultAsync(d => d.ServiceID == DeleteID);

		if (deceased != null)
		{
			Db.Deceased.Remove(deceased);
			await Db.SaveChangesAsync();
		}

		if (UserState.ServiceID == DeleteID) // if delete the active record
			UserState.ServiceID = "None"; // grey‑out Modify Records again

		ConfirmingDeleteId = null; // collapse the inline confirm panel
	}
}

<style>
	.Spacing {
		padding: .25rem;
	}

	.form-select {
		max-width: 10%;
	}

	.form-control {
		max-width: 20%;
	}
</style>
