@page "/Search Records"

@using RESTDB.Models

@inject RESTDB.Data.ApplicationDbContext Db
@inject NavigationManager NavigationManager
@inject REST.Services.GlobalState GlobalState

@rendermode InteractiveServer

<h3>Search Deceased Records</h3>

<form @onsubmit="HandleSubmit">
	<div class="mb-3">
		<label>Select Field:</label>
		<select @bind="selectedField" class="form-select">
			@foreach (var field in searchFields)
			{
				<option value="@field.Value">@field.Key</option>
			}
		</select>
	</div>
	<div class="mb-3">
		<input type="text" @bind="searchTerm" placeholder="Enter search term..." class="form-control" />
	</div>
	<button type="submit" class="btn btn-submit btn-primary" style="background-color: #936091; color: white; border: none">Search</button>
</form>

@if (isLoading)
{
	<p><em>Loading...</em></p>
}
else if (results != null && results.Any())
{
	<table class="table table-striped mt-3">
		<thead>
			<tr>
				<th>Client ID</th>
				<th>First Name</th>
				<th>Last Name</th>
				<th>Director</th>
				<th>City</th>
				<th>DoD</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in results)
			{
				<tr>
					<td>@item.ClientID</td>
					<td>@item.FirstName</td>
					<td>@item.LastName</td>
					<td>@item.Director</td>
					<td>@item.City</td>
					<td>@item.DoD?.ToString("MM-dd-yyyy")</td>
					<td>
						<button type="button" @onclick="() => StartEdit(item.ClientID ?? -1)">Edit</button>
						<span class="Spacing"></span>
						@if (ConfirmingDeleteId == @item.ClientID)
						{
							<div class="mt-1">
								<button type="button" class="btn btn-danger me-2" @onclick="() => ConfirmDelete(item.ClientID ?? -1)">Confirm Delete</button>
								<button type="button" class="btn btn-success" @onclick="CancelDelete">Cancel</button>
							</div>
						}
						else
						{
							<button type="button" @onclick="() => ShowConfirmDelete(item.ClientID ?? -1)">Delete</button>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else if (searched)
{
	<p class="mt-3"><em>No results found.</em></p>
}

@code {
	private string searchTerm = string.Empty;
	private string selectedField = "FirstName";
	private List<Deceased> results = new();
	private bool isLoading = false;
	private bool searched = false;
	private int? ConfirmingDeleteId = null;
	private Dictionary<string, string> searchFields = new()
	{
		{ "First Name", "FirstName" },
		{ "Last Name", "LastName" },
		{ "City", "City" },
		{ "Director", "Director" },
		{ "Status", "Status" },
		{ "SSN", "SSN" },
		{ "Gender", "Gender" },
		{ "Maiden Name", "MaidenName" }
	};
	private async Task HandleSubmit()
	{
		await Search();
	}

	private async Task Search()
	{
		isLoading = true;
		searched = false;

		IQueryable<Deceased> query = Db.Deceased;

		if (!string.IsNullOrWhiteSpace(searchTerm))
		{
			query = selectedField switch
			{
				"FirstName" => query.Where(d => d.FirstName != null && d.FirstName.Contains(searchTerm)),
				"LastName" => query.Where(d => d.LastName != null && d.LastName.Contains(searchTerm)),
				"City" => query.Where(d => d.City != null && d.City.Contains(searchTerm)),
				"Director" => query.Where(d => d.Director != null && d.Director.Contains(searchTerm)),
				"Status" => query.Where(d => d.Status != null && d.Status.Contains(searchTerm)),
				"SSN" => query.Where(d => d.SSN != null && d.SSN.Contains(searchTerm)),
				"Gender" => query.Where(d => d.Gender != null && d.Gender.Contains(searchTerm)),
				"MaidenName" => query.Where(d => d.MaidenName != null && d.MaidenName.Contains(searchTerm)),
				_ => query
			};
		}
		query = query.OrderByDescending(d => d.DoD);
		results = await query.ToListAsync();
		isLoading = false;
		searched = true;
	}

	private void StartEdit(int ClientID)
	{
		GlobalState.ClientID = ClientID;
		Console.WriteLine($"ClientID: {GlobalState.ClientID}");
		NavigationManager.NavigateTo($"/Modify%20Records?currentRecordString={ClientID}");
	}

	private void ShowConfirmDelete(int ClientID)
	{
		ConfirmingDeleteId = ClientID;
	}

	private void CancelDelete()
	{
		ConfirmingDeleteId = null;
	}

	private async Task ConfirmDelete(int ClientID)
	{ /* use one DB‑transaction so every table is cleaned together */
		await using var tx = await Db.Database.BeginTransactionAsync();

		try
		{ // remove the parent record
			var deceased = await Db.Deceased.FirstOrDefaultAsync(d => d.ClientID == ClientID);
			if (deceased != null)
				Db.Deceased.Remove(deceased);

			// remove every child row created in First Call
			Db.Airline.RemoveRange(          Db.Airline.          Where(r => r.ClientID == ClientID));
			Db.Buyer.RemoveRange(            Db.Buyer.            Where(r => r.ClientID == ClientID));
			Db.CashAdvance.RemoveRange(      Db.CashAdvance.      Where(r => r.ClientID == ClientID));
			Db.ContainerShipping.RemoveRange(Db.ContainerShipping.Where(r => r.ClientID == ClientID));
			Db.Embalmer.RemoveRange(         Db.Embalmer.         Where(r => r.ClientID == ClientID));
			Db.FlagApplication.RemoveRange(  Db.FlagApplication.  Where(r => r.ClientID == ClientID));
			Db.Military.RemoveRange(         Db.Military.         Where(r => r.ClientID == ClientID));
			Db.MilitaryStint.RemoveRange(    Db.MilitaryStint.    Where(r => r.ClientID == ClientID));
			Db.Monument.RemoveRange(         Db.Monument.         Where(r => r.ClientID == ClientID));
			Db.ObituaryData.RemoveRange(     Db.ObituaryData.     Where(r => r.ClientID == ClientID));
			Db.PlaceOfDeath.RemoveRange(     Db.PlaceOfDeath.     Where(r => r.ClientID == ClientID));
			Db.Products.RemoveRange(         Db.Products.         Where(r => r.ClientID == ClientID));
			Db.ServiceContract.RemoveRange(  Db.ServiceContract.  Where(r => r.ClientID == ClientID));
			Db.Services.RemoveRange(         Db.Services.         Where(r => r.ClientID == ClientID));
			Db.Survivors.RemoveRange(        Db.Survivors.        Where(r => r.ClientID == ClientID));
			Db.WarsServed.RemoveRange(       Db.WarsServed.       Where(r => r.ClientID == ClientID));

			await Db.SaveChangesAsync();
			await tx.CommitAsync();
		}
		catch
		{
			await tx.RollbackAsync();
			throw; // let the Blazor error boundary show a useful message
		}
		results = await Db.Deceased.ToListAsync(); // refresh the grid

		if (GlobalState.ClientID == ClientID) // if delete the active record
			GlobalState.ClientID = 0; // grey‑out Modify Records again

		ConfirmingDeleteId = null; // collapse the inline confirm panel
	}
}

<style>
	.Spacing {
		padding: .25rem;
	}

	.form-select {
		max-width: 10%;
	}

	.form-control {
		max-width: 20%;
	}
</style>
