@page "/Military"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Military</PageTitle>

<div class="title-bar">
    <h1>Modify Military Service Record</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingMilitary" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="MilitaryForm">
    <EditForm Model="@editingMilitary">
        <h5>Military Service Information</h5>

        <div class="Form-group">
            <label>Branch</label>
            <InputText class="form-control" @bind-Value="editingMilitary.Branch" />
        </div>

        <div class="Form-group">
            <label>Rank</label>
            <InputText class="form-control" @bind-Value="editingMilitary.Rank" />
        </div>

        <div class="Form-group">
            <label>Service Number</label>
            <InputText class="form-control" @bind-Value="editingMilitary.ServiceNumber" />
        </div>

        <div class="Form-group">
            <label>Start Date</label>
            <InputDate class="form-control" @bind-Value="editingMilitary.StartDate" />
        </div>

        <div class="Form-group">
            <label>End Date</label>
            <InputDate class="form-control" @bind-Value="editingMilitary.EndDate" />
        </div>
    </EditForm>
</div>

@code {
    private List<Military> militaryList = new();
    private Military editingMilitary = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        militaryList = await Context.Military.ToListAsync();

        if (militaryList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < militaryList.Count;
                }
            }

            editingMilitary = CloneMilitary(currentRecordIndex > 0 ? militaryList[currentRecordIndex - 1] : militaryList.Last());
        }
    }

    private Military CloneMilitary(Military original)
    {
        return new Military
        {
            Id = original.Id,
            Branch = original.Branch,
            Rank = original.Rank,
            ServiceNumber = original.ServiceNumber,
            StartDate = original.StartDate,
            EndDate = original.EndDate
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingMilitary = militaryList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < militaryList.Count)
        {
            currentRecordIndex++;
            editingMilitary = militaryList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < militaryList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        var entity = await Context.Military.FirstOrDefaultAsync(m => m.Id == editingMilitary.Id);
        if (entity is not null)
        {
            entity.Branch = editingMilitary.Branch;
            entity.Rank = editingMilitary.Rank;
            entity.ServiceNumber = editingMilitary.ServiceNumber;
            entity.StartDate = editingMilitary.StartDate;
            entity.EndDate = editingMilitary.EndDate;

            await Context.SaveChangesAsync();
        }
    }
}

<style>
/* MilitaryForm */
