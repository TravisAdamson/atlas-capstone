@page "/Military"

@inject RESTDB.Data.ApplicationDbContext Db
@inject NavigationManager NavigationManager
@inject REST.Services.GlobalState GlobalState

@using RESTDB.Models
@using RESTDB.Migrations
@using RESTDB.Data
@using REST.Components.Shared
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@inherits LayoutComponentBase

@rendermode InteractiveServer

<ActiveService
	Director="@editingDeceased.Director"
	ServiceID="@editingDeceased.ServiceID"
	FirstName="@editingDeceased.FirstName"
	MiddleName="@editingDeceased.MiddleName"
	LastName="@editingDeceased.LastName"
	Need="@editingDeceased.Need"
	Status="@editingDeceased.Status"
	ContractBalance="@Convert.ToDecimal(editingDeceased.ContractBalance)"
	Photo="@editingDeceased.Image" />


<PageTitle>Military Record</PageTitle>

<div class="title-bar">
	<h1>Military Record</h1>
	<div class="SubmitRecordButton">
		<EditForm Model="@editingMilitary" OnValidSubmit="SaveMilitaryRecord">
			<div class="SaveButtonFirst">
				<button type="submit" class="btn btn-primary btn-submit" style="background-color: #936091;">Save</button>
			</div>
		</EditForm>
	</div>
</div>

<!-- Main Military Record Fields -->
<EditForm Model="@editingMilitary">
	<div class="ContractForm">
		<div class="pod-field-container">
			<div class="FirstCall-group1"><label>Branch</label><InputText class="form-control" @bind-Value="editingMilitary.Branch" /></div>
			<div class="FirstCall-group1"><label>Service Number</label><InputText class="form-control" @bind-Value="editingMilitary.ServiceNumber" /></div>
			<div class="FirstCall-group1"><label>Start Date</label><InputDate class="form-control" @bind-Value="editingMilitary.StartDate" /></div>
			<div class="FirstCall-group1"><label>End Date</label><InputDate class="form-control" @bind-Value="editingMilitary.EndDate" /></div>
		</div>
	</div>
</EditForm>

<!-- Tabs Navigation -->
<div class="TabForm">
	<div class="tab-buttons">
		<button @onclick="@(() => SelectTab("Stints"))" class="tab-button @(selectedTab == "Stints" ? "active" : "")">Military Stints</button>
		<button @onclick="@(() => SelectTab("Wars"))" class="tab-button @(selectedTab == "Wars" ? "active" : "")">Wars Served</button>
		<button @onclick="@(() => SelectTab("Flags"))" class="tab-button @(selectedTab == "Flags" ? "active" : "")">Flag Application</button>
	</div>
</div>

<!-- Tab Content -->
<div class="Tabinfoform">
<div class="FirstCall-group">
	<div class="FirstCall-group1">
		@if (selectedTab == "Stints")
		{
		<h5>Military Stints</h5>
			<div class="tab-content">
				<div class="FirstCall-group1">
					<label>Description</label>
					<InputText class="fcall" @bind-Value="editingStint.Description" />
				</div>
				<div class="FirstCall-group1">
					<label>Start Date</label>
					<InputDate class="fcall" @bind-Value="editingStint.StartDate" />
				</div>
				<div class="FirstCall-group1">
					<label>End Date</label>
					<InputDate class="fcall" @bind-Value="editingStint.EndDate" />
				</div>
			</div>
		}
		else if (selectedTab == "Wars")
		{
			<h5>Wars Served</h5>
			<div class="tab-content">
				<div class="FirstCall-group1">
					<label>War Name</label>
					<InputText class="fcall" @bind-Value="editingWar.WarName" />
				</div>
				<div class="FirstCall-group1">
					<label>Description</label>
					<InputText class="fcall" @bind-Value="editingWar.Description" />
				</div>
			</div>
		}
		else if (selectedTab == "Flags")
		{
		<h5>Flag Application</h5>
		<div class="tab-content">
			<div class="FirstCall-group1">
				<label>Applicant Name</label>
				<InputText class="fcall" @bind-Value="editingFlag.ApplicantName" />
			</div>
			<div class="FirstCall-group1">
				<label>Relationship</label>
				<InputText class="fcall" @bind-Value="editingFlag.RelationshipToDeceased" />
			</div>
			<div class="FirstCall-group1">
				<label>Flag Type</label>
				<InputText class="fcall" @bind-Value="editingFlag.FlagType" />
			</div>
			<div class="FirstCall-group1">
				<label>Application Date</label>
				<InputDate class="fcall" @bind-Value="editingFlag.ApplicationDate" />
			</div>
		</div>
		}
	</div>
</div>
</div>

@code {
	private List<Military> militaryList = new List<Military>();
	private Military editingMilitary = new Military();
	private Military currentMilitary = new Military();
	private MilitaryStint editingStint = new();
	private WarsServed editingWar = new();
	private FlagApplication editingFlag = new();
	private List<Deceased> deceasedList = new List<Deceased>();
	private Deceased currentDeceased = new Deceased();
	private Deceased editingDeceased = new Deceased();
	private string selectedTab = "Stints";


	protected override async Task OnInitializedAsync()
	{
		var uri = NavigationManager.Uri;
		var query = new Uri(uri).Query;
		var queryParameters = QueryHelpers.ParseQuery(query);

		militaryList = await Db.Military.ToListAsync();
		deceasedList = await Db.Deceased.ToListAsync();
		editingDeceased = CloneDeceased(deceasedList[GlobalState.clientID - 1]);
		editingMilitary = CloneMilitary(militaryList[GlobalState.clientID - 1]);
	}

	private Deceased CloneDeceased(Deceased original)
	{
		return new Deceased
		{
			ClientID = original.ClientID,
			ServiceID = original.ServiceID,
			Director = original.Director,
			FirstName = original.FirstName,
			LastName = original.LastName,
			MiddleName = original.MiddleName,
			Title = original.Title,
			Suffix = original.Suffix,
			Need = original.Need,
			Status = original.Status,
			StreetAddress = original.StreetAddress,
			City = original.City,
			State = original.State,
			ZipCode = original.ZipCode,
			ContractBalance = original.ContractBalance,
			DoD = original.DoD,
			TimeOfDeath = original.TimeOfDeath,
			SSN = original.SSN,
			Gender = original.Gender,
			MaidenName = original.MaidenName,
			Alias = original.Alias,
			Vet = original.Vet,
			War = original.War,
			InformantName = original.InformantName,
			IStreetAddress = original.IStreetAddress,
			ICity = original.ICity,
			IState = original.IState,
			IZipCode = original.IZipCode,
			IPhoneNumber = original.IPhoneNumber,
			InformantEmail = original.InformantEmail,
			InfoNotified = original.InfoNotified,
			Notes = original.Notes,
			Image = original.Image,
			InformantRelation = original.InformantRelation,
			DoB = original.DoB,
			Age = original.Age,
			BCity = original.BCity,
			BZip = original.BZip,
			BCounty = original.BCounty,
			BState = original.BState,
			BCountry = original.BCountry,
			MStatus = original.MStatus,
			MDate = original.MDate,
			MPlace = original.MPlace,
			Church = original.Church,
			RPreference = original.RPreference,
			Clergy = original.Clergy,
			HighSchool = original.HighSchool,
			HYoE = original.HYoE,
			HEL = original.HEL,
			College = original.College,
			CYoE = original.CYoE,
			CEL = original.CEL
		};
	}

	private Military CloneMilitary(Military original)
	{
		return new Military
		{
			Id = original.Id,
			Branch = original.Branch,
			ServiceNumber = original.ServiceNumber,
			StartDate = original.StartDate,
			EndDate = original.EndDate
		};
	}

	private async Task SaveMilitaryRecord()
	{
		var entity = await Db.Military.FirstOrDefaultAsync(m => m.Id == editingMilitary.Id);
		if (entity is not null)
		{
			entity.Id = editingMilitary.Id;
			entity.Branch = editingMilitary.Branch;
			entity.ServiceNumber = editingMilitary.ServiceNumber;
			entity.StartDate = editingMilitary.StartDate;
			entity.EndDate = editingMilitary.EndDate;

			await Db.SaveChangesAsync();
		}
	}

	private void SelectTab(string tabName)
	{
		selectedTab = tabName;
	}
}

<style>
