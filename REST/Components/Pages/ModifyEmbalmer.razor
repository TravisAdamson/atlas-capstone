@page "/Embalmer"

@inject RESTDB.Data.ApplicationDbContext Db
@inject NavigationManager NavigationManager
@inject REST.Services.GlobalState GlobalState

@using RESTDB.Models
@using RESTDB.Migrations
@using RESTDB.Data
@using REST.Components.Shared
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@inherits LayoutComponentBase

@rendermode InteractiveServer

<ActiveService
	Director="@editingDeceased.Director"
	ServiceID="@editingDeceased.ServiceID"
	FirstName="@editingDeceased.FirstName"
	MiddleName="@editingDeceased.MiddleName"
	LastName="@editingDeceased.LastName"
	Need="@editingDeceased.Need"
	Status="@editingDeceased.Status"
	ContractBalance="@Convert.ToDecimal(editingDeceased.ContractBalance)"
	Photo="@editingDeceased.Image" />

<PageTitle>Embalmer</PageTitle>

<div class="title-bar">
	<h1>Modify Embalmer Record</h1>
	<div class="SubmitRecordButton">
		<EditForm Model="@editingEmbalmer" OnValidSubmit="SaveRecord">
			<div class="SaveButtonFirst">
				<button type="submit" class="btn btn-primary btn-submit">Save</button>
			</div>
		</EditForm>
	</div>
</div>

<div class="EmbalmerForm">
	<EditForm Model="@editingEmbalmer">
		<h5>Embalmer Information</h5>

		<div class="Form-group">
			<div>
				<label>Permission to Embalm</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingEmbalmer.PermissionToEmbalm" />
			</div>

			<div>
				<label>Embalmed</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingEmbalmer.Embalmed" />
			</div>

			<div>
				<label>Embalmed Date</label>
				<InputDate class="form-control" @bind-Value="editingEmbalmer.EmbalmedDate" />
			</div

			<div>
				<label>Embalmed Time</label>
				<InputDate class="form-control" @bind-Value="editingEmbalmer.EmbalmedTime" />
			</div>
		</div>

	<div class="Form-group2">
		<div>
			<label>Embalmed By</label>
			<InputText class="form-control" @bind-Value="editingEmbalmer.EmbalmedBy" />
		</div>

		<div>
			<label>Embalming Authorizor</label>
			<InputText class="form-control" @bind-Value="editingEmbalmer.EmbalmingAuthorizor" />
		</div>
	</div>
	</EditForm>
</div>


@code {
	private List<Embalmer> embalmerList = new();
	private Embalmer editingEmbalmer = new();
	private int currentRecordIndex = 0;
	private string? currentRecordString;
	private bool preVis = true, nexVis = true;
	private List<Deceased> deceasedList = new List<Deceased>();
	private Deceased currentDeceased = new Deceased();
	private Deceased editingDeceased = new Deceased();

	protected override async Task OnInitializedAsync()
	{
		// grab the selected client ID (0 if none)
		var id = GlobalState.ClientID;

		// 2. load the full lists
		embalmerList = await Db.Embalmer.ToListAsync();
		deceasedList = await Db.Deceased.ToListAsync();

		// if no valid ID or no embalmers, nothing to do
		if (id <= 0 || !embalmerList.Any())
			return;

		// bind the Deceased and Embalmer we actually want
		editingDeceased = CloneDeceased(
			deceasedList.FirstOrDefault(d => d.ClientID == id)
			?? new Deceased());
		editingEmbalmer = CloneEmbalmer(
			embalmerList.FirstOrDefault(e => e.ClientID == id)
			?? new Embalmer());

		// find its index in the embalmerList so prev/next work
		var idx = embalmerList.FindIndex(e => e.ClientID == id);
		if (idx >= 0)
		{
			currentRecordIndex = idx + 1;
			preVis             = currentRecordIndex > 1;
			nexVis             = currentRecordIndex < embalmerList.Count;
		}
	}


	private Embalmer CloneEmbalmer(Embalmer original)
	{
		return new Embalmer
		{
			ClientID = original.ClientID,
			PermissionToEmbalm = original.PermissionToEmbalm,
			Embalmed = original.Embalmed,
			EmbalmedDate = original.EmbalmedDate,
			EmbalmedTime = original.EmbalmedTime,
			EmbalmedBy = original.EmbalmedBy,
			EmbalmingAuthorizor = original.EmbalmingAuthorizor
		};
	}
	private Deceased CloneDeceased(Deceased original)
	{
		return new Deceased
		{
			ClientID = original.ClientID,
			ServiceID = original.ServiceID,
			Director = original.Director,
			FirstName = original.FirstName,
			LastName = original.LastName,
			MiddleName = original.MiddleName,
			Title = original.Title,
			Suffix = original.Suffix,
			Need = original.Need,
			Status = original.Status,
			StreetAddress = original.StreetAddress,
			City = original.City,
			State = original.State,
			ZipCode = original.ZipCode,
			ContractBalance = original.ContractBalance,
			DoD = original.DoD,
			TimeOfDeath = original.TimeOfDeath,
			SSN = original.SSN,
			Gender = original.Gender,
			MaidenName = original.MaidenName,
			Alias = original.Alias,
			Vet = original.Vet,
			War = original.War,
			InformantName = original.InformantName,
			IStreetAddress = original.IStreetAddress,
			ICity = original.ICity,
			IState = original.IState,
			IZipCode = original.IZipCode,
			IPhoneNumber = original.IPhoneNumber,
			InformantEmail = original.InformantEmail,
			InfoNotified = original.InfoNotified,
			Notes = original.Notes,
			Image = original.Image,
			InformantRelation = original.InformantRelation,
			DoB = original.DoB,
			Age = original.Age,
			BCity = original.BCity,
			BZip = original.BZip,
			BCounty = original.BCounty,
			BState = original.BState,
			BCountry = original.BCountry,
			MStatus = original.MStatus,
			MDate = original.MDate,
			MPlace = original.MPlace,
			Church = original.Church,
			RPreference = original.RPreference,
			Clergy = original.Clergy,
			HighSchool = original.HighSchool,
			HYoE = original.HYoE,
			HEL = original.HEL,
			College = original.College,
			CYoE = original.CYoE,
			CEL = original.CEL
		};
	}

	private async Task SaveRecord()
	{
		var entity = await Db.Embalmer.FirstOrDefaultAsync(e => e.ClientID == editingEmbalmer.ClientID);
		if (entity is not null)
		{
			entity.PermissionToEmbalm = editingEmbalmer.PermissionToEmbalm;
			entity.Embalmed = editingEmbalmer.Embalmed;
			entity.EmbalmedDate = editingEmbalmer.EmbalmedDate;
			entity.EmbalmedTime = editingEmbalmer.EmbalmedTime;
			entity.EmbalmedBy = editingEmbalmer.EmbalmedBy;
			entity.EmbalmingAuthorizor = editingEmbalmer.EmbalmingAuthorizor;

			await Db.SaveChangesAsync();
		}
	}
}
