		box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
	}

	.Form-group {
		display: flex;
		gap: 4rem;
		margin-bottom: .25rem;
		padding-left: .25rem;
	}

	.Form-group2 {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: .25rem;
		margin-bottom: .25rem;
		padding-left: .25rem;
		padding-right: .25rem;
		max-width: 20%;
	}

	.form-control {
		border: 2px solid rgb(255, 255, 255);
		border-radius: 0.2rem;
		padding: .5rem;
		box-sizing: border-box;
		max-height: 36px;
	}

	.title-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0px;
	}

	.navigation-controls {
		display: flex;
		gap: 10px;
	}

	.btn-submit, .btn-secondary {
		color: white;
		font-size: 1em;
		border-radius: 5px;
	}

	.btn-submit {
		background-color: #936091;
	}

	.btn-secondary {
