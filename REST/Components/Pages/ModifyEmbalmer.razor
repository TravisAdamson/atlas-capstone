@page "/Embalmer"
@inject RESTDB.Data.ApplicationDbContext Context
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Embalmer</PageTitle>

<div class="title-bar">
    <h1>Modify Embalmer Record</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingEmbalmer" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="EmbalmerForm">
    <EditForm Model="@editingEmbalmer">
        <h5>Embalmer Information</h5>

        <div class="Form-group">
            <div>
                <label>Permission to Embalm</label>
                <InputCheckbox class="form-check-input" @bind-Value="editingEmbalmer.PermissionToEmbalm" />
            </div>

            <div>
                <label>Embalmed</label>
                <InputCheckbox class="form-check-input" @bind-Value="editingEmbalmer.Embalmed" />
            </div>

            <div>
                <label>Embalmed Date</label>
                <InputDate class="form-control" @bind-Value="editingEmbalmer.EmbalmedDate" />
            </div

            <div>
                <label>Embalmed Time</label>
                <InputDate class="form-control" @bind-Value="editingEmbalmer.EmbalmedTime" />
            </div>
        </div>

    <div class="Form-group2">
        <div>
            <label>Embalmed By</label>
            <InputText class="form-control" @bind-Value="editingEmbalmer.EmbalmedBy" />
        </div>

        <div>
            <label>Embalming Authorizor</label>
            <InputText class="form-control" @bind-Value="editingEmbalmer.EmbalmingAuthorizor" />
        </div>
    </div>
    </EditForm>
</div>



@code {
    private List<Embalmer> embalmerList = new();
    private Embalmer editingEmbalmer = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        embalmerList = await Context.Embalmer.ToListAsync();

        if (embalmerList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < embalmerList.Count;
                }
            }

            editingEmbalmer = CloneEmbalmer(currentRecordIndex > 0 ? embalmerList[currentRecordIndex - 1] : embalmerList.Last());
        }
    }

    private Embalmer CloneEmbalmer(Embalmer original)
    {
        return new Embalmer
        {
            Id = original.Id,
            PermissionToEmbalm = original.PermissionToEmbalm,
            Embalmed = original.Embalmed,
            EmbalmedDate = original.EmbalmedDate,
            EmbalmedTime = original.EmbalmedTime,
            EmbalmedBy = original.EmbalmedBy,
            EmbalmingAuthorizor = original.EmbalmingAuthorizor
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingEmbalmer = embalmerList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < embalmerList.Count)
        {
            currentRecordIndex++;
            editingEmbalmer = embalmerList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < embalmerList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        var entity = await Context.Embalmer.FirstOrDefaultAsync(e => e.Id == editingEmbalmer.Id);
        if (entity is not null)
        {
            entity.PermissionToEmbalm = editingEmbalmer.PermissionToEmbalm;
            entity.Embalmed = editingEmbalmer.Embalmed;
            entity.EmbalmedDate = editingEmbalmer.EmbalmedDate;
            entity.EmbalmedTime = editingEmbalmer.EmbalmedTime;
            entity.EmbalmedBy = editingEmbalmer.EmbalmedBy;
            entity.EmbalmingAuthorizor = editingEmbalmer.EmbalmingAuthorizor;

            await Context.SaveChangesAsync();
        }
    }
}
<style>
    .EmbalmerForm h5 {
        font-size: 2em;
    }

    .EmbalmerForm {
        max-width: 100%;
        margin: 20px;
        padding: 20px;
        background-color: rgb(187, 188, 188);
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .Form-group {
        display: flex;
        gap: 4rem;
        margin-top: 25px;
        margin-bottom: 10px;
    }

    .Form-group2 {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 15px;
        margin-bottom: 10px;
    }

    label {
        font-weight: bold;
        text-wrap: nowrap;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        font-size: 1em;
        margin-top: 5px;
        border-radius: 5px;
    }

    .title-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .navigation-controls {
        display: flex;
        gap: 10px;
    }

    .btn-submit, .btn-secondary {
        padding: 10px 20px;
        color: white;
        font-size: 1em;
        border-radius: 5px;
        border: none;
    }

    .btn-submit {
        background-color: #936091;
    }

    .btn-secondary {
        background-color: #6c757d;
    }
</style>