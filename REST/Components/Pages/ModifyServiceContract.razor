@page "/ModifyServiceContract"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Modify Service Contract</PageTitle>

<div class="title-bar">
    <h1>Modify Service Contract</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingContract" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="ContractForm">
    <EditForm Model="@editingContract">
        <h5>Contract Details</h5>

        <div class="Form-group">
            <label>Contract Date</label>
            <InputDate class="form-control" @bind-Value="editingContract.ContractDate" />
        </div>

        <div class="Form-group">
            <label>Sales Package</label>
            <InputText class="form-control" @bind-Value="editingContract.SalesPackage" />
        </div>

        <div class="Form-group">
            <label>Estate Owner</label>
            <InputText class="form-control" @bind-Value="editingContract.EstateOwner" />
        </div>

        <div class="Form-group">
            <label>Balance</label>
            <InputNumber class="form-control" @bind-Value="editingContract.Balance" />
        </div>

        <div class="Form-group">
            <label>Distributed Charges</label>
            <InputNumber class="form-control" @bind-Value="editingContract.DistributedCharges" />
        </div>
    </EditForm>
</div>

@code {
    private List<ServiceContract> contractList = new();
    private ServiceContract editingContract = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        contractList = await Context.ServiceContract.ToListAsync();

        if (contractList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < contractList.Count;
                }
            }

            editingContract = CloneContract(currentRecordIndex > 0 ? contractList[currentRecordIndex - 1] : contractList.Last());
        }
    }

    private ServiceContract CloneContract(ServiceContract original)
    {
        return new ServiceContract
        {
            Id = original.Id,
            ContractDate = original.ContractDate,
            SalesPackage = original.SalesPackage,
            EstateOwner = original.EstateOwner,
            Balance = original.Balance,
            DistributedCharges = original.DistributedCharges
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingContract = contractList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < contractList.Count)
        {
            currentRecordIndex++;
            editingContract = contractList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < contractList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        var entity = await Context.ServiceContract.FirstOrDefaultAsync(m => m.Id == editingContract.Id);
        if (entity is not null)
        {
            entity.ContractDate = editingContract.ContractDate;
            entity.SalesPackage = editingContract.SalesPackage;
            entity.EstateOwner = editingContract.EstateOwner;
            entity.Balance = editingContract.Balance;
            entity.DistributedCharges = editingContract.DistributedCharges;

            await Context.SaveChangesAsync();
        }
    }
}
<style>
/* ContractForm */
.ContractForm {
    max-width: 100%;
    margin: 20px;
    padding: 20px;
    background-color: #f4f7fc;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

h5 {
    font-size: 1.5em;
    margin-bottom: 15px;
}

.Form-group {
    margin-bottom: 15px;
}

label {
    font-weight: bold;
}

.form-control {
    width: 100%;
    padding: 10px;
    font-size: 1em;
    margin-top: 5px;
    border-radius: 5px;
}

.title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.navigation-controls {
    display: flex;
    gap: 10px;
}

.SubmitRecordButton {
    display: flex;
    justify-content: flex-end;
}

.SaveButtonFirst {
    margin-top: 20px;
}

.btn-submit, .btn-secondary {
    padding: 10px 20px;
    color: white;
    font-size: 1em;
    border-radius: 5px;
    border: none;
}

.btn-submit {
    background-color: #936091;
}

.btn-secondary {
    background-color: #6c757d;
}

.SaveButtonFirst button:hover {
    cursor: pointer;
}

</style>