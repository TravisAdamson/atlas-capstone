@page "/ModifyService"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Modify Service</PageTitle>

<div class="title-bar">
    <h1>Modify Service</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingService" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="ServiceForm">
    <EditForm Model="@editingService">
        <h5>Service Information</h5>

        <div class="Form-group">
            <label>Category</label>
            <InputText class="form-control" @bind-Value="editingService.Category" />
        </div>

        <div class="Form-group">
            <label>Item</label>
            <InputText class="form-control" @bind-Value="editingService.Item" />
        </div>

        <div class="Form-group">
            <label>Tax Rate</label>
            <InputNumber class="form-control" @bind-Value="editingService.Tax" />
        </div>

        <div class="Form-group">
            <label>Price</label>
            <InputNumber class="form-control" @bind-Value="editingService.Price" />
        </div>
    </EditForm>
</div>

@code {
    private List<Services> serviceList = new();
    private Services editingService = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        serviceList = await Context.Services.ToListAsync();

        if (serviceList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < serviceList.Count;
                }
            }

            editingService = CloneService(currentRecordIndex > 0 ? serviceList[currentRecordIndex - 1] : serviceList.Last());
        }
    }

    private Services CloneService(Services original)
    {
        return new Services
        {
            Id = original.Id,
            Category = original.Category,
            Item = original.Item,
            Tax = original.Tax,
            Price = original.Price
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingService = serviceList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < serviceList.Count)
        {
            currentRecordIndex++;
            editingService = serviceList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < serviceList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        var entity = await Context.Services.FirstOrDefaultAsync(s => s.Id == editingService.Id);
        if (entity is not null)
        {
            entity.Category = editingService.Category;
            entity.Item = editingService.Item;
            entity.Tax = editingService.Tax;
            entity.Price = editingService.Price;

            await Context.SaveChangesAsync();
        }
    }
}

<style>
/* Shared Service/Service Form Styles */
.ServiceForm {
    max-width: 100%;
    margin: 20px;
    padding: 20px;
    background-color: #f4f7fc;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

h5 {
    font-size: 1.5em;
    margin-bottom: 15px;
}

.Form-group {
    margin-bottom: 15px;
}

label {
    font-weight: bold;
}

.form-control {
    width: 100%;
    padding: 10px;
    font-size: 1em;
    margin-top: 5px;
    border-radius: 5px;
}

/* Title bar & navigation buttons */
.title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.navigation-controls {
    display: flex;
    gap: 10px;
}

.SubmitRecordButton {
    display: flex;
    justify-content: flex-end;
}

.SaveButtonFirst {
    margin-top: 20px;
}

/* Button Styling */
.btn-submit, .btn-secondary {
    padding: 10px 20px;
    color: white;
    font-size: 1em;
    border-radius: 5px;
    border: none;
}

.btn-submit {
    background-color: #936091;
}

.btn-secondary {
    background-color: #6c757d;
}

.SaveButtonFirst button:hover {
    cursor: pointer;
}
</style>
