@page "/ModifyBuyer"
@inject RESTDB.Data.ApplicationDbContext Context
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Modify Buyer</PageTitle>

<div class="title-bar">
    <h1>Modify Buyer</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary" style="background-color: #936091;">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary" style="background-color: #936091;">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingBuyer" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit" style="background-color: #936091;">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="ContactForm">
    <EditForm Model="@editingBuyer">
        <h5>Buyer Information</h5>
        <div class="FirstCall-group">
            <div class="FirstCall-group1">
                <label>Name</label>
                <InputText class="fcall" @bind-Value="editingBuyer.Name" />
            </div>
            <div class="FirstCall-group1">
                <label>Address</label>
                <InputText class="fcall" @bind-Value="editingBuyer.Address" />
            </div>
            <div class="FirstCall-group1">
                <label>Phone Number</label>
                <InputText class="fcall" @bind-Value="editingBuyer.PhoneNumber" />
            </div>
            <div class="FirstCall-group1">
                <label>Relationship</label>
                <InputText class="fcall" @bind-Value="editingBuyer.Relationship" />
            </div>
            <div class="FirstCall-group1">
                <label>Primary Buyer?</label>
                <InputCheckbox class="fcall" @bind-Value="editingBuyer.IsPrimaryBuyer" />
            </div>
            <div class="FirstCall-group1">
                <label>Send Bill?</label>
                <InputCheckbox class="fcall" @bind-Value="editingBuyer.SendBill" />
            </div>
        </div>
    </EditForm>
</div>

@code {
    private List<Buyer> buyerList = new();
    private Buyer editingBuyer = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        buyerList = await Context.Buyer.ToListAsync();

        if (buyerList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < buyerList.Count;
                }
            }

            editingBuyer = CloneBuyer(currentRecordIndex > 0 ? buyerList[currentRecordIndex - 1] : buyerList.Last());
        }
    }

    private Buyer CloneBuyer(Buyer original)
    {
        return new Buyer
        {
            Id = original.Id,
            Name = original.Name,
            Address = original.Address,
            PhoneNumber = original.PhoneNumber,
            Relationship = original.Relationship,
            IsPrimaryBuyer = original.IsPrimaryBuyer,
            SendBill = original.SendBill
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingBuyer = buyerList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < buyerList.Count)
        {
            currentRecordIndex++;
            editingBuyer = buyerList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < buyerList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        if (string.IsNullOrWhiteSpace(editingBuyer.Name))
        {
            Console.WriteLine("Name is required.");
            return;
        }

        var entity = await Context.Buyer.FirstOrDefaultAsync(a => a.Id == editingBuyer.Id);
        if (entity is not null)
        {
            entity.Name = editingBuyer.Name;
            entity.Address = editingBuyer.Address;
            entity.PhoneNumber = editingBuyer.PhoneNumber;
            entity.Relationship = editingBuyer.Relationship;
            entity.IsPrimaryBuyer = editingBuyer.IsPrimaryBuyer;
            entity.SendBill = editingBuyer.SendBill;

            await Context.SaveChangesAsync();
        }
    }
}

<style>
.title-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.navigation-controls {
    display: flex;
    gap: .5rem;
}

.ContactForm {
    border-radius: 6px;
    padding-left: .25rem;
    padding-top: .25rem;
    background-color: rgb(187, 188, 188);
}

.FirstCall-group {
    display: flex;
    flex-wrap: wrap;
}

.FirstCall-group1 {
    display: flex;
    flex-direction: column;
    margin-right: 1rem;
    margin-bottom: .5rem;
}

.fcall {
    border: 2px solid rgb(253, 251, 251);
    border-radius: 0.2rem;
    padding: .5rem;
    box-sizing: border-box;
    max-height: 36px;
}
</style>