@page "/ModifyProduct"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Modify Product</PageTitle>

<div class="title-bar">
    <h1>Modify Product</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingProduct" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="MilitaryForm">
    <EditForm Model="@editingProduct">
        <h5>Product Details</h5>

        <div class="Form-group"><label>Category</label><InputText class="form-control" @bind-Value="editingProduct.Category" /></div>
        <div class="Form-group"><label>Item</label><InputText class="form-control" @bind-Value="editingProduct.Item" /></div>
        <div class="Form-group"><label>Tax (%)</label><InputNumber class="form-control" @bind-Value="editingProduct.Tax" /></div>
        <div class="Form-group"><label>Price ($)</label><InputNumber class="form-control" @bind-Value="editingProduct.Price" /></div>
    </EditForm>
</div>

@code {
    private List<Products> productList = new();
    private Products editingProduct = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        productList = await Context.Products.ToListAsync();

        if (productList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < productList.Count;
                }
            }

            editingProduct = CloneProduct(currentRecordIndex > 0 ? productList[currentRecordIndex - 1] : productList.Last());
        }
    }

    private Products CloneProduct(Products original)
    {
        return new Products
        {
            Id = original.Id,
            Category = original.Category,
            Item = original.Item,
            Tax = original.Tax,
            Price = original.Price
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingProduct = productList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < productList.Count)
        {
            currentRecordIndex++;
            editingProduct = productList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < productList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        var entity = await Context.Products.FirstOrDefaultAsync(p => p.Id == editingProduct.Id);
        if (entity is not null)
        {
            entity.Category = editingProduct.Category;
            entity.Item = editingProduct.Item;
            entity.Tax = editingProduct.Tax;
            entity.Price = editingProduct.Price;

            await Context.SaveChangesAsync();
        }
    }
}
<style>
.MilitaryForm {
    max-width: 100%;
    margin: 20px;
    padding: 20px;
    background-color: #f4f7fc;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

h5 {
    font-size: 1.5em;
    margin-bottom: 15px;
}

.Form-group {
    margin-bottom: 15px;
}

label {
    font-weight: bold;
}

.form-control {
    width: 100%;
    padding: 10px;
    font-size: 1em;
    margin-top: 5px;
    border-radius: 5px;
}

.title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.navigation-controls {
    display: flex;
    gap: 10px;
}

.SubmitRecordButton {
    display: flex;
    justify-content: flex-end;
}

.SaveButtonFirst {
    margin-top: 20px;
}

.btn-submit, .btn-secondary {
    padding: 10px 20px;
    color: white;
    font-size: 1em;
    border-radius: 5px;
    border: none;
}

.btn-submit {
    background-color: #936091;
}

.btn-secondary {
    background-color: #6c757d;
}

.SaveButtonFirst button:hover {
    cursor: pointer;
}
</style>
