@page "/ModifyStint"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using RESTDB.Models

<PageTitle>Modify Military Stint</PageTitle>

<div class="title-bar">
    <h1>Modify Military Stint</h1>
    <div class="navigation-controls">
        @if (preVis) { <button @onclick="PreviousRecord" class="btn btn-secondary">Previous</button> }
        @if (nexVis) { <button @onclick="NextRecord" class="btn btn-secondary">Next</button> }
    </div>
    <div class="SubmitRecordButton">
        <EditForm Model="@editingStint" OnValidSubmit="SaveRecord">
            <div class="SaveButtonFirst">
                <button type="submit" class="btn btn-primary btn-submit">Save</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="MilitaryForm">
    <EditForm Model="@editingStint">
        <h5>Stint Information</h5>

        <div class="Form-group">
            <label>Description</label>
            <InputText class="form-control" @bind-Value="editingStint.Description" />
        </div>

        <div class="Form-group">
            <label>Start Date</label>
            <InputDate class="form-control" @bind-Value="editingStint.StartDate" />
        </div>

        <div class="Form-group">
            <label>End Date</label>
            <InputDate class="form-control" @bind-Value="editingStint.EndDate" />
        </div>

        <div class="Form-group">
            <label>Stint Military ID</label>
            <InputText class="form-control" @bind-Value="editingStint.StintMilitaryId" />
        </div>
    </EditForm>
</div>

@code {
    private List<MilitaryStint> stintList = new();
    private MilitaryStint editingStint = new();
    private int currentRecordIndex = 0;
    private string? currentRecordString;
    private bool preVis = true, nexVis = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri;
        var query = new Uri(uri).Query;
        var queryParameters = QueryHelpers.ParseQuery(query);

        stintList = await Context.MilitaryStint.ToListAsync();

        if (stintList.Any())
        {
            if (queryParameters.TryGetValue("currentRecordString", out var value))
            {
                currentRecordString = value;
                if (int.TryParse(currentRecordString, out var currentRecord))
                {
                    currentRecordIndex = currentRecord;
                    preVis = currentRecord > 1;
                    nexVis = currentRecord < stintList.Count;
                }
            }

            editingStint = CloneStint(currentRecordIndex > 0 ? stintList[currentRecordIndex - 1] : stintList.Last());
        }
    }

    private MilitaryStint CloneStint(MilitaryStint original)
    {
        return new MilitaryStint
        {
            Id = original.Id,
            Description = original.Description,
            StartDate = original.StartDate,
            EndDate = original.EndDate,
            StintMilitaryId = original.StintMilitaryId
        };
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 1)
        {
            currentRecordIndex--;
            editingStint = stintList[currentRecordIndex - 1];
            preVis = currentRecordIndex > 1;
            nexVis = true;
        }
        else
        {
            preVis = false;
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < stintList.Count)
        {
            currentRecordIndex++;
            editingStint = stintList[currentRecordIndex - 1];
            nexVis = currentRecordIndex < stintList.Count;
            preVis = true;
        }
        else
        {
            nexVis = false;
        }
    }

    private async Task SaveRecord()
    {
        var entity = await Context.MilitaryStint.FirstOrDefaultAsync(s => s.Id == editingStint.Id);
        if (entity is not null)
        {
            entity.Description = editingStint.Description;
            entity.StartDate = editingStint.StartDate;
            entity.EndDate = editingStint.EndDate;
            entity.StintMilitaryId = editingStint.StintMilitaryId;

            await Context.SaveChangesAsync();
        }
    }
}
<style>
