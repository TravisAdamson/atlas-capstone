@if (showResults)
{
    <h3>SAVED RESULTS</h3>
    <ul>
        @foreach (var deceased in Deceased)
        {
            <li>
                <strong>@deceased.FirstName @deceased.LastName</strong><br />
                Middle Name: @deceased.MiddleName<br />
                StreetAddress: @deceased.StreetAddress<br />
                City: @deceased.City<br />
                State: @deceased.State<br />
                Zipcode: @deceased.ZipCode<br />
                Title: @deceased.Title<br />
                Suffix: @deceased.Suffix<br />
                Status: @deceased.Status<br />
                Contract Balance: @deceased.ContractBalance<br />
                Date of Death: @deceased.DoD?.ToString("yyyy-MM-dd")<br />
                Time of Death: @deceased.TimeOfDeath?.ToString("")<br />
                SSN: @deceased.SSN<br />
                Gender: @deceased.Gender<br />
                Maiden Name: @deceased.MaidenName<br />
                Alias: @deceased.Alias<br />
                Phone Number: @deceased.IPhoneNumber<br />
                Veteran Status: @deceased.Vet<br />
                War: @deceased.War<br />
                InformantName: @deceased.InformantName<br />
                IStreetAddress: @deceased.IStreetAddress<br />
                ICity: @deceased.ICity<br />
                IState: @deceased.IState<br />
                IZipcode: @deceased.IZipcode<br />
                IPhoneNumber: @deceased.IPhoneNumber<br />
                Informant Email: @deceased.InformantEmail<br />
                Info Notified: @deceased.InfoNotified?.ToString("yyyy-MM-dd")<br />
                Notes: @deceased.Notes<br />
            </li>
        }
    </ul>
}
@code {
    private List<RESTDB.Models.Deceased> Deceased = new List<RESTDB.Models.Deceased>();
    private RESTDB.Models.Deceased currentDeceased = new RESTDB.Models.Deceased();

    // Phone and SSN part bindings
    private string? PhonePart1 { get; set; }
    private string? PhonePart2 { get; set; }
    private string? PhonePart3 { get; set; }

    private string? SSNPart1 { get; set; }
    private string? SSNPart2 { get; set; }
    private string? SSNPart3 { get; set; }

    private bool showResults = false;

    protected override async Task OnInitializedAsync()
    {
        Deceased = await Context.Deceased.ToListAsync();
    }

    private int GetNextClientID()
    {
        var lastDeceased = Context.Deceased.OrderByDescending(d => d.ClientID).FirstOrDefault();
        return lastDeceased?.ClientID + 1 ?? 1;
    }

    private async Task SaveRecord()
    {
        if (string.IsNullOrEmpty(currentDeceased.FirstName) || string.IsNullOrEmpty(currentDeceased.LastName))
        {
            Console.WriteLine("First Name and Last Name are required.");
            return;
        }

        // Format SSN
        if (string.IsNullOrEmpty(SSNPart1) || string.IsNullOrEmpty(SSNPart2) || string.IsNullOrEmpty(SSNPart3))
        {
            Console.WriteLine("SSN is required.");
        }
		else
			currentDeceased.SSN = $"{SSNPart1}-{SSNPart2}-{SSNPart3}";

        // Format Phone Number
        if (string.IsNullOrEmpty(PhonePart1) || string.IsNullOrEmpty(PhonePart2) || string.IsNullOrEmpty(PhonePart3))
        {
            Console.WriteLine("Phone number is required.");
        }
		else
			currentDeceased.IPhoneNumber = $"({PhonePart1}){PhonePart2}-{PhonePart3}";

        // Save
        currentDeceased.ClientID = GetNextClientID();
        Context.Deceased.Add(currentDeceased);
        await Context.SaveChangesAsync();

        currentDeceased = new RESTDB.Models.Deceased();
        PhonePart1 = PhonePart2 = PhonePart3 = string.Empty;
        SSNPart1 = SSNPart2 = SSNPart3 = string.Empty;
        showResults = true;
    }
    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file != null)
        {
            try
            {
                using (var memoryStream = new MemoryStream())
                {
                    await file.OpenReadStream().CopyToAsync(memoryStream);
                    currentDeceased.Image = memoryStream.ToArray(); // Store the image as a byte array
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error uploading image: {ex.Message}");
            }
        }
    }
}
