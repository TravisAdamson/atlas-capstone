@page "/First Call"

<PageTitle>First Call</PageTitle>

<div class="forms">
    <div class="form1">
        <!-- FirstCall -->
        <div class="FirstCall-group">
            <div class="FirstCall-group1">
                <label for="client-id">Client ID</label>
                <input
                    id="client-id"
                    class="fcall"
                    type="text"
                    name="client-id" />
            </div>
            <div class="FirstCall-group1">
                <label for="director">Director</label>
                <input
                    id="director"
                    class="fcall"
                    type="text"
                    name="director" />
            </div>
        </div>

        <!-- Name Info -->
        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="last-name">Last Name</label>
                <input
                    id="last-name"
                    class="fcall"
                    type="text"
                    name="last-name"
                />
            </div>
            <div class="FirstCall-group1">
                <label for="first-name">First Name</label>
                <input
                    id="first-name"
                    class="fcall"
                    type="text"
                    name="first-name" />
            </div>
            <div class="FirstCall-group1">
                <label for="middle-name">Middle Name</label>
                <input
                    id="middle-name"
                    class="fcall"
                    type="text"
                    name="middle-name" />
            </div>
            <div class="FirstCall-group1">
                <label for="suffix">Suffix</label>
                <select id="suffix" name="suffix">
                    <option value="mr">Mr.</option>
                    <option value="ms">Ms.</option>
                    <option value="dr">Dr.</option>
                </select>
            </div>
				<!-- Display Image -->
        		<div class="display-img">
            		<div>
            		<img class="img-class">
            	</div>
        	</div>
        </div>

        <!-- Display Name -->
        <div class="display-name">
            <div class="FirstCall-group1">
                <label for="display">Display Name</label>
                <input
                    id="display"
                    class="fcall"
                    type="text"
                    name="display"
                />
            </div>
        </div>
    </div>

    <!-- Deceased -->
    <div class="form2">
        <h5>Deceased</h5>
        <div class="FirstCall-group">
            <div class="FirstCall-group1">
                <label for="deathdate">Death Date</label>
                <input id="deatedate" class="fcall" type="text" name="deathdate" />
            </div>

            <div class="FirstCall-group1">
                <label for="time">Time</label>
                <input
                    class="fcall"
                    type="time"
                    id="time"
                    placeholder="_:__"
                    />
            </div>

            <div class="FirstCall-group1">
                <label for="snn">Social Security Number</label>
                <input
                    class="fcall"
                    type="text"
                    id="ssn"
                    name="ssn"
                    placeholder="123-45-6789"
                    pattern="\d{3}-\d{2}-\d{4}"
                    title="Format: 123-45-6789"
                    maxlength="11"
                    value="@ssnValue"
                    @oninput="FormatSSN"
                />
            </div>

            <!-- Sex -->
            <div class="FirstCall-group1">
                <label>Sex</label>
                <div class="genderlabel">
                    <input type="radio" name="gender" value="Male" /> Male
                    <input type="radio" name="gender" value="Female" /> Female
                    <input type="radio" name="gender" value="Other" /> Other
                </div>
            </div>

            <div class="FirstCall-group1">
                <label for="display name">Maiden Name</label>
                <input
                    id="display"
                    class="fcall"
                    type="text"
                    name="display"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="display name">Alias</label>
                <input
                    id="display"
                    class="fcall"
                    type="text"
                    name="display"
                />
            </div>
        </div>

        <!-- Street row -->
        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="last-name">Last Name</label>
                <input
                    id="last-name"
                    class="fcall"
                    type="text"
                    name="last-name" />
            </div>

            <div class="FirstCall-group1">
                <label for="last-name">First Name</label>
                <input
                    id="last-name"
                    class="fcall"
                    type="text"
                    name="last-name" />
            </div>

            <div class="FirstCall-group1">
                <label for="display name">Zip</label>
                <input
                    id="display"
                    class="fcall"
                    type="text"
                    name="display"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="display name">City</label>
                <input
                    id="display"
                    class="fcall"
                    type="text"
                    name="display"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="display name">County</label>
                <input
                    id="display"
                    class="fcall"
                    type="text"
                    name="display"
                />
            </div>
        </div>

        <!-- State row -->
        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="last-name">State</label>
                <input
                    id="last-name"
                    class="fcall"
                    type="text"
                    name="last-name" />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Country</label>
                <input
                    id="country"
                    class="fcall"
                    type="text"
                    name="country"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Locality Type</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>
        </div>

        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="state">Home City</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Home State</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Previous State</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Phone Number</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Veteran</label>
                <input
                    id="state"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">War Served</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>
        </div>
        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="state">Informant</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Origin Type</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Date Information</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Date Amended</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>
        </div>

        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="state">Email Address</label>
                <input
                    id="state"
                    class="fcall"
                    type="email"
                    name="state"
                />
            </div>
        </div>
        <div>
            <div>
                <button>Save</button>
            </div>
        </div>
    </div>
</div>

@code {
    private string ssnValue = "";
    private void FormatSSN(ChangeEventArgs e)
    {
        string digits = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? []);

        if (digits.Length > 9)
            digits = digits.Substring(0, 9);

        if (digits.Length >= 5)
            ssnValue = $"{digits.Substring(0, 3)}-{digits.Substring(3, 2)}-{digits.Substring(5)}";
        else if (digits.Length >= 3)
            ssnValue = $"{digits.Substring(0, 3)}-{digits.Substring(3)}";
        else
            ssnValue = digits;
    }
}