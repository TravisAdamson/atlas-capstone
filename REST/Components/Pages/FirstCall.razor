@page "/First Call"
@inject RESTDB.Data.ApplicationDbContext Context
@rendermode InteractiveServer

<PageTitle>First Call</PageTitle>

<h1>Create Record</h1>

<style>
    .forms {
        padding: 1rem;
    }

    .ContactForm, .DeceasedForm, .ContractForm, .InformantForm {
        border: 1px solid #000000;
        border-radius: 8px;
        padding: 1rem;
        margin: 1rem auto;
        background-color: rgb(187, 188, 188);
    }

    .FirstCall-group {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .FirstCall-group1 {
        display: flex;
        flex-direction: column;
        margin-right: 1rem;
        margin-bottom: 1rem;
    }

    .fcall {
        border: 2px solid rgb(253, 251, 251);
        border-radius: 0.2rem;
        padding: 0.5rem;
        box-sizing: border-box;
        max-height: 36px;
    }

    .numcall1 {
        border: 2px solid rgb(253, 251, 251);
        border-radius: 0.2rem;
        padding: 0.5rem;
        box-sizing: border-box;
        max-height: 36px;
        width: 50px;
    }

    .numcall2 {
        border: 2px solid rgb(253, 251, 251);
        border-radius: 0.2rem;
        padding: 0.5rem;
        box-sizing: border-box;
        max-height: 36px;
        width: 45px;
    }

    .numcall3 {
        border: 2px solid rgb(253, 251, 251);
        border-radius: 0.2rem;
        padding: 0.5rem;
        box-sizing: border-box;
        max-height: 36px;
        width: 55px;
    }

    .zipcall {
        border: 2px solid rgb(253, 251, 251);
        border-radius: 0.2rem;
        padding: 0.5rem;
        box-sizing: border-box;
        max-height: 36px;
        width: 100px;
    }

    .genderlabel {
        display: flex;
        flex-direction: row;
        gap: 1rem;
    }

    .btn-submit {
        margin-top: 1rem;
    }
    /* Hide number input incrementing arrows */    /* this is probably not needed if we get the input type right for the box. this just hides the arrows, it doesnt remove the ability to use arrow keys to increment/decrement the integer in the field. also currently allows for negative integers. */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type="number"] {
        -moz-appearance: textfield;
    }

    .gender-container {
        margin-bottom: 15px;
    }

    .gender-group {
        display: flex;
        flex-direction: column;
    }

    .suffix-container, .IState-container {
        margin-bottom: 15px;
        display: flex;
        flex-direction: column;
        margin-right: 1rem;
    }

    .suffix-group {
        display: flex;
        flex-direction: column;
    }

    .notes-field {
        min-height: 6rem;
    }
</style>

<EditForm id="ContactForm" Model="@currentDeceased" OnValidSubmit="SaveRecord" FormName="ContactForm" class="ContactForm">
    <h5>First Call Information</h5>
    <div class="FirstCall-group">
        <!-- Director -->
        <div class="FirstCall-group1">
            <label for="Director">Director</label>
            <InputSelect @bind-Value="currentDeceased.Director" class="State-group" TValue="string">
                    <option value="Travis">Denise Adamson</option>
                    <option value="Nolan">Jon Hoopert</option>
                    <option value="Kevin">James Groesbeck</option>
            </InputSelect>
        </div>
        <!-- Case Status -->
        <div class="FirstCall-group1">
            <label for="Status">Case Status:</label>
            <InputText id="Status" class="fcall" @bind-Value="currentDeceased.Status" />
        </div>
    </div>
</EditForm>

<EditForm id="DeceasedForm" Model="@currentDeceased" OnValidSubmit="SaveRecord" FormName="DeceasedForm" class="DeceasedForm">
