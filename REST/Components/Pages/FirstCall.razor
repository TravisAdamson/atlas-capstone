@page "/First Call"

<PageTitle>First Call</PageTitle>

<h1>Create Record</h1>

<div class="forms">
    <!-- Deceased -->
    <div class="form2">
        <h5>Deceased</h5>
        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="last-name">Last Name</label>
                <input
                    id="last-name"
                    class="fcall"
                    type="text"
                    name="last-name" />
            </div>

            <div class="FirstCall-group1">
                <label for="first-name">First Name</label>
                <input
                    id="first-name"
                    class="fcall"
                    type="text"
                    name="first-name" />
            </div>

            <div class="FirstCall-group1">
                <label for="middle-name">Middle Name</label>
                <input
                    id="middle-name"
                    class="fcall"
                    type="text"
                    name="middle-name" />
            </div>

            <div class="FirstCall-group1">
                <label for="suffix">Suffix</label>
                <select id="suffix" name="suffix">
                    <option value="mr">Mr.</option>
                    <option value="ms">Ms.</option>
                    <option value="dr">Dr.</option>
                </select>
            </div>
        </div>
        <div class="FirstCall-group">
            <div class="FirstCall-group1">
                <label for="deathdate">Date of Death</label>
                <input id="deatedate" class="fcall" type="date" name="deathdate" />
            </div>

            <div class="FirstCall-group1">
                <label for="time">Time</label>
                <input
                    class="fcall"
                    type="time"
                    id="time"
                    placeholder="_:__"
                    />
            </div>

            <div class="FirstCall-group1">
                <label for="snn">Social Security Number</label>
                <input
                    class="fcall"
                    type="text"
                    id="ssn"
                    name="ssn"
                    placeholder="123-45-6789"
                    pattern="\d{3}-\d{2}-\d{4}"
                    title="Format: 123-45-6789"
                    maxlength="11"
                    @bind="ssnValue"
                    @oninput="FormatSSN"
                    onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                />
            </div>

            <!-- Sex -->
            <div class="FirstCall-group1">
                <label>Sex</label>
                <div class="genderlabel">
                    <input type="radio" name="gender" value="Male" /> Male
                    <input type="radio" name="gender" value="Female" /> Female
                    <input type="radio" name="gender" value="Other" /> Other
                </div>
            </div>

            <div class="FirstCall-group1">
                <label for="maiden-name">Maiden Name</label>
                <input
                    id="maiden-name"
                    class="fcall"
                    type="text"
                    name="maiden-name"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="alias">Alias</label>
                <input
                    id="alias"
                    class="fcall"
                    type="text"
                    name="alias"
                />
            </div>
        </div>

        <!-- State row -->
        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="display name">City</label>
                <input
                    id="display"
                    class="fcall"
                    type="text"
                    name="display"
                />
            </div>
            <div class="FirstCall-group1">
                <label for="state">State</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state" />
            </div>
        </div>

      <div class="name-group">
            <div class="FirstCall-group1">
                <label for="zipcode">Zip</label>
                <input
                    id="zipcode"
                    class="fcall"
                    type="text"
                    name="zipcode"
                    maxlength="5"
                    placeholder="12345"
                    @bind="zipCode"
                    @oninput="Zip"
                    onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="county">County</label>
                <input
                    id="county"
                    class="fcall"
                    type="text"
                    name="county"
                />
            </div>
        </div>

        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="city">Home City</label>
                <input
                    id="city"
                    class="fcall"
                    type="text"
                    name="city"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Home State</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="state">Previous State</label>
                <input
                    id="state"
                    class="fcall"
                    type="text"
                    name="state"
                />
            </div>
        </div>

        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="vet">Veteran</label>
                <input
                    id="vet"
                    name="vet"
                    type="checkbox"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="war">War Served</label>
                <input
                    id="war"
                    class="fcall"
                    type="text"
                    name="war"
                />
            </div>
        </div>
        <div class="name-group">
            <div class="FirstCall-group1">
                <label for="informant">Informant</label>
                <input
                    id="informant"
                    class="fcall"
                    type="text"
                    name="informant"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="origin">Origin Type</label>
                <input
                    id="origin"
                    class="fcall"
                    type="text"
                    name="origin"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="date-info">Date Information</label>
                <input
                    id="date-info"
                    class="fcall"
                    type="date"
                    name="date-info"
                />
            </div>

            <div class="FirstCall-group1">
                <label for="date-amend">Date Amended</label>
                <input
                    id="date-amend"
                    class="fcall"
                    type="date"
                    name="date-amend"
                />
            </div>
        </div>
        <div>
            <div class="display-name">
			    <!-- Display Image -->
			    <div class="display-img">
				    <div>
					    <img class="img-class">
				    </div>
			    </div>
            </div>
        </div>
        <div>
            <div>
                <button>Save</button>
            </div>
        </div>
    </div>
</div>

@code {
    private string ssnValue = "";
    private string zipCode = "";

    private void Zip(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        var digits = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? []);

        if (digits.Length > 5)
            digits = digits[..5];
        
        zipCode = digits;
    }
    private void FormatSSN(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        var digits = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? []);

        if (digits.Length > 9)
            digits = digits.Substring(0, 9);

        if (digits.Length >= 5)
            ssnValue = $"{digits.Substring(0, 3)}-{digits.Substring(3, 2)}-{digits.Substring(5)}";
        else if (digits.Length >= 3)
            ssnValue = $"{digits.Substring(0, 3)}-{digits.Substring(3)}";
        else
            ssnValue = digits;
    }
}