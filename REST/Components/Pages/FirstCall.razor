@page "/First Call"
@inject RESTDB.Data.ApplicationDbContext Context


<PageTitle>First Call</PageTitle>

<h1>Create Record</h1>

<EditForm Model="@currentDeceased" OnValidSubmit="SaveRecord" FormName="FirstCallForm">

	<div>
		<label for="FirstNameField">First Name:</label>
		<InputText id="FirstNameField" class="form-control" @bind-Value="FirstNameValue" @onchange="HandleFirstNameChange"/>
	</div>

    <div>
        <label for="LastName">Last Name:</label>
        <InputText id="LastName" class="form-control" @bind-Value="LastNameValue" @onchange="HandleLastNameChange"/>
    </div>

	<div>
        <label for="MiddleName">Middle Name:</label>
        <InputText id="MiddleName" class="form-control" @bind-Value="currentDeceased.MiddleName" />
    </div>

	<div>
        <label for="Title">Title:</label>
        <InputText id="Title" class="form-control" @bind-Value="currentDeceased.Title" />
    </div>

    <div>
        <label for="Suffix">Suffix:</label>
        <InputText id="Suffix" class="form-control" @bind-Value="currentDeceased.Suffix" />
    </div>

    <div>
        <label for="Status">Status:</label>
        <InputText id="Status" class="form-control" @bind-Value="currentDeceased.Status" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>
<h3>Deceased List</h3>
<ul>
    @foreach (var Deceased in Deceased)
    {
        <li>@Deceased.FirstName @Deceased.LastName</li>
    }
</ul>

@code {
    private List<RESTDB.Models.Deceased> Deceased = new List<RESTDB.Models.Deceased>();
	private RESTDB.Models.Deceased currentDeceased = new RESTDB.Models.Deceased();

	private string FirstNameValue="David";
	private string LastNameValue="Adam";
    protected override async Task OnInitializedAsync()
    {
        Deceased = await Context.Deceased.ToListAsync();
    }

	private void HandleFirstNameChange(ChangeEventArgs e)
	{
    	Console.WriteLine($"First Name changed: {e.Value}");
	}

	private void HandleLastNameChange(ChangeEventArgs e)
	{
    	Console.WriteLine($"Last Name changed: {e.Value}");
	}
    private async Task SaveRecord()
    {
		currentDeceased.FirstName=FirstNameValue;
		currentDeceased.LastName=LastNameValue;
		if (string.IsNullOrEmpty(currentDeceased.FirstName) || string.IsNullOrEmpty(currentDeceased.LastName))
        {
        	Console.WriteLine($"Invalid data: First Name = '{currentDeceased.FirstName}', Last Name = '{currentDeceased.LastName}' are required.");
        }

		Context.Deceased.Add(currentDeceased);
        await Context.SaveChangesAsync();
        Deceased = await Context.Deceased.ToListAsync();
        currentDeceased = new RESTDB.Models.Deceased();
    }
}
