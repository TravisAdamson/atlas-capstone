@page "/Survivor"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@inject REST.Services.GlobalState GlobalState
@using RESTDB.Models
@using RESTDB.Migrations
@using RESTDB.Data
@inherits LayoutComponentBase
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using REST.Components.Shared
@namespace REST.Components

<ActiveService
	Director="@editingDeceased.Director"
	FirstName="@editingDeceased.FirstName"
	MiddleName="@editingDeceased.MiddleName"
	LastName="@editingDeceased.LastName"
	Title="@editingDeceased.Title"
	Status="@editingDeceased.Status"
	ContractBalance="@Convert.ToDecimal(editingDeceased.ContractBalance)"
	Photo="@editingDeceased.Image" />

<PageTitle>Survivor</PageTitle>

<div class="title-bar">
	<h1>Modify Survivor</h1>
	<div class="SubmitRecordButton">
		<EditForm Model="@editingSurvivor" OnValidSubmit="SaveRecord">
			<div class="SaveButtonFirst">
				<button type="submit" class="btn btn-primary btn-submit">Save</button>
			</div>
		</EditForm>
	</div>
</div>

<div class="SurvivorForm">
	<EditForm Model="@editingSurvivor">
		<h5>Survivor Information</h5>
		<div class="Survivor-group">
			<div class="Form-group">
				<label>Survivor Relation</label>
				<InputText class="form-control" @bind-Value="editingSurvivor.SurvivorRelation" />
			</div>
			<div class="Form-group">
				<label>Name</label>
				<InputText class="form-control" @bind-Value="editingSurvivor.Name" />
			</div>
			<div class="Form-group">
				<label>Address</label>
				<InputText class="form-control" @bind-Value="editingSurvivor.Address" />
			</div>
			<div class="Form-group">
				<label>Children Count</label>
				<InputText class="form-control" @bind-Value="editingSurvivor.GreatGrandChildrenCount" />
			</div>
			<div class="Form-group">
				<label>Grandchildren Count</label>
				<InputText class="form-control" @bind-Value="editingSurvivor.GrandChildrenCount" />
			</div>
			<div class="Form-group">
				<label>Great Grandchildren Count</label>
				<InputText class="form-control" @bind-Value="editingSurvivor.GreatGreatGrandChildrenCount" />
			</div>
			<div class="Form-group">
				<label>Great Great Grandchildren Count</label>
				<InputText class="form-control" @bind-Value="editingSurvivor.GreatGreatGreatGrandChildrenCount" />
			</div>
			<div class="Form-group">
				<label>Great Great Great Grandchildren Count</label>
				<InputText class="form-control" @bind-Value="editingSurvivor.ChildrenCount" />
			</div>
		</div>

		<div class="Survivor-group">
			<div class="Form-group">
				<label>Phone Number</label>
				<InputText class="form-control" @bind-Value="editingSurvivor.PhoneNumber" />
			</div>
			<div class="Form-group">
				<label>Relationship</label>
				<InputText class="form-control" @bind-Value="editingSurvivor.Relationship" />
			</div>
			<div class="Form-group">
				<label>Is Living</label>
				<InputCheckbox class="form-control" @bind-Value="editingSurvivor.IsLiving" />
			</div>
		</div>
	</EditForm>
</div>

@code {
	private List<Survivors> survivorList = new();
	private Survivors editingSurvivor = new();
	private int currentRecordIndex = 0;
	private string? currentRecordString;
	private bool preVis = true, nexVis = true;
	private List<Deceased> deceasedList = new List<Deceased>();
	private Deceased currentDeceased = new Deceased();
	private Deceased editingDeceased = new Deceased();

	protected override async Task OnInitializedAsync()
	{
		var uri = NavigationManager.Uri;
		var query = new Uri(uri).Query;
		var queryParameters = QueryHelpers.ParseQuery(query);

		survivorList = await Context.Survivors.ToListAsync();
		deceasedList = await Context.Deceased.ToListAsync();

		if (survivorList.Any())
		{
			if (queryParameters.TryGetValue("currentRecordString", out var value))
			{
				currentRecordString = value;
				if (int.TryParse(currentRecordString, out var currentRecord))
				{
					currentRecordIndex = currentRecord;
					preVis = currentRecord > 1;
					nexVis = currentRecord < survivorList.Count;
				}
			}
			editingSurvivor = CloneSurvivor(currentRecordIndex > 0 ? survivorList[currentRecordIndex - 1] : survivorList.Last());
			editingDeceased = CloneDeceased(deceasedList[GlobalState.clientID - 1]);
		}
	}

	private Survivors CloneSurvivor(Survivors original)
	{
		return new Survivors
		{
			Id = original.Id,
			SurvivorRelation = original.SurvivorRelation,
			Name = original.Name,
			Address = original.Address,
			GreatGrandChildrenCount = original.GreatGrandChildrenCount,
			GreatGreatGrandChildrenCount = original.GreatGreatGrandChildrenCount,
			GreatGreatGreatGrandChildrenCount = original.GreatGreatGreatGrandChildrenCount,
			ChildrenCount = original.ChildrenCount,
			GrandChildrenCount = original.GrandChildrenCount,
			PhoneNumber = original.PhoneNumber,
			Relationship = original.Relationship,
			IsLiving = original.IsLiving
		};
	}

	private Deceased CloneDeceased(Deceased original)
	{
		return new Deceased
		{
			ClientID = original.ClientID,
			Director = original.Director,
			FirstName = original.FirstName,
			LastName = original.LastName,
			MiddleName = original.MiddleName,
			Title = original.Title,
			Suffix = original.Suffix,
			Status = original.Status,
			StreetAddress = original.StreetAddress,
			City = original.City,
			State = original.State,
			ZipCode = original.ZipCode,
			ContractBalance = original.ContractBalance,
			DoD = original.DoD,
			TimeOfDeath = original.TimeOfDeath,
			SSN = original.SSN,
			Gender = original.Gender,
			MaidenName = original.MaidenName,
			Alias = original.Alias,
			Vet = original.Vet,
			War = original.War,
			InformantName = original.InformantName,
			IStreetAddress = original.IStreetAddress,
			ICity = original.ICity,
			IState = original.IState,
			IZipCode = original.IZipCode,
			IPhoneNumber = original.IPhoneNumber,
			InformantEmail = original.InformantEmail,
			InfoNotified = original.InfoNotified,
			Notes = original.Notes,
			Image = original.Image,
			InformantRelation = original.InformantRelation
		};
	}

	private async Task SaveRecord()
	{
		var entity = await Context.Survivors.FirstOrDefaultAsync(s => s.Id == editingSurvivor.Id);
		if (entity is not null)
		{
			entity.SurvivorRelation = editingSurvivor.SurvivorRelation;
			entity.Name = editingSurvivor.Name;
			entity.Address = editingSurvivor.Address;
			entity.GreatGrandChildrenCount = editingSurvivor.GreatGrandChildrenCount;
			entity.GreatGreatGrandChildrenCount = editingSurvivor.GreatGreatGrandChildrenCount;
			entity.GreatGreatGreatGrandChildrenCount = editingSurvivor.GreatGreatGreatGrandChildrenCount;
			entity.ChildrenCount = editingSurvivor.ChildrenCount;
			entity.GrandChildrenCount = editingSurvivor.GrandChildrenCount;
			entity.PhoneNumber = editingSurvivor.PhoneNumber;
			entity.Relationship = editingSurvivor.Relationship;
			entity.IsLiving = editingSurvivor.IsLiving;

			await Context.SaveChangesAsync();
		}
	}
}

<style> /* Shared Survivor Form Styles */
.SurvivorForm {
	border-radius: 6px;
	padding-left: .25rem;
	padding-right: .25rem;
	background-color: rgb(187, 188, 188);
}

.Survivor-group {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
}

.Form-group {
		display: flex;
		flex-direction: column;
		margin-bottom: .5rem;
}

h5 {
	font-size: 1.7em;
	margin-bottom: 15px;
}

.form-control {
	border: 2px solid rgb(255, 255, 255);
	border-radius: 0.2rem;
	padding: .5rem;
	box-sizing: border-box;
	max-height: 36px;
}

.title-bar { /* Title bar & navigation buttons */
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.navigation-controls {
	display: flex;
	gap: 10px;
}

.btn-submit {
	background-color: #936091;
}
</style>
