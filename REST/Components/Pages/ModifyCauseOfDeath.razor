@page "/Cause of Death"
@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@inject REST.Services.GlobalState GlobalState
@using RESTDB.Models
@using RESTDB.Migrations
@using RESTDB.Data
@using REST.Components.Shared
@inherits LayoutComponentBase
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<ActiveService
	Director="@editingDeceased.Director"
	ServiceID="@editingDeceased.ServiceID"
	FirstName="@editingDeceased.FirstName"
	MiddleName="@editingDeceased.MiddleName"
	LastName="@editingDeceased.LastName"
	Need="@editingDeceased.Need"
	Status="@editingDeceased.Status"
	ContractBalance="@Convert.ToDecimal(editingDeceased.ContractBalance)"
	Photo="@editingDeceased.Image" />

<PageTitle>Cause of Death</PageTitle>

<div class="title-bar">
	<h1>Modify Cause of Death</h1>
	<div class="SubmitRecordButton">
		<EditForm Model="@editingCause" OnValidSubmit="SaveRecord">
			<div class="SaveButtonFirst">
				<button type="submit" class="btn btn-primary btn-submit">Save</button>
			</div>
		</EditForm>
	</div>
</div>

<div class="CauseForm">
	<EditForm Model="@editingCause">
		<h5>Cause of Death Information</h5>
		<div class="Cause-group">
			<div class="Form-group">
				<label>Manner</label>
				<InputText class="form-control" @bind-Value="editingCause.Manner" />
			</div>
			<div class="Form-group">
				<label>Other</label>
				<InputText class="form-control" @bind-Value="editingCause.Other" />
			</div>
			<div class="Form-group">
				<label>Cause Factors</label>
				<InputText class="form-control" @bind-Value="editingCause.CauseFactors" />
			</div
			<div class="Form-group">
				<label>Other Factors</label>
				<InputText class="form-control" @bind-Value="editingCause.OtherFactors" />
			</div>
		</div>
		<div class="Cause-group">
			<div class="Form-group">
				<label>Type Of Factor</label>
				<InputText class="form-control" @bind-Value="editingCause.TypeofFactor" />
			</div>
			<div class="Form-group">
				<label>Diabetic</label>
				<InputText class="form-control" @bind-Value="editingCause.Diabetic" />
			</div>
			<div class="Form-group">
				<label>Diabetes Contributed</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingCause.DContributed" />
			</div>
			<div class="Form-group">
				<label>Tobacco Use</label>
				<InputText class="form-control" @bind-Value="editingCause.TobaccoUse" />
			</div>
			<div class="Form-group">
				<label>Alcohol Use</label>
				<InputText class="form-control" @bind-Value="editingCause.AlcoholUse" />
			</div>
			<div class="Form-group">
				<label>Hospitalized</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingCause.Hospitalized" />
			</div>
			<div class="Form-group">
				<label>Deffered Diagnosis</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingCause.DefferedDiag" />
			</div>
			<div class="Form-group">
				<label>Communicable Disease</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingCause.CommDisease" />
			</div>
			<div class="Form-group">
				<label>Organ or Tisue donation considered</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingCause.DonationConsidered" />
			</div>
			<div class="Form-group">
				<label>Consent for Donation</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingCause.DonationConsented" />
			</div>
			<div class="Form-group">
				<label>Anatomical Gift Considered</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingCause.AnatGiftConsidered" />
			</div>
			<div class="Form-group">
				<label>Deceased Viewed</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingCause.Viewed" />
			</div>
			<div class="Form-group">
				<label>Biopsy</label>
				<InputCheckbox class="form-check-input" @bind-Value="editingCause.Biopsy" />
			</div>
			<div class="Form-group">
				<label>Anatomical Gift</label>
				<InputText class="form-control" @bind-Value="editingCause.AnatGift" />
			</div>
		</div>
	</EditForm>
</div>

@code {
	private List<CauseOfDeath> causeList = new();
	private CauseOfDeath editingCause = new();
	private int currentRecordIndex = 0;
	private string? currentRecordString;
	private bool preVis = true, nexVis = true;
	private List<Deceased> deceasedList = new List<Deceased>();
	private Deceased currentDeceased = new Deceased();
	private Deceased editingDeceased = new Deceased();

	protected override async Task OnInitializedAsync()
	{
		var uri = NavigationManager.Uri;
		var query = new Uri(uri).Query;
		var queryParameters = QueryHelpers.ParseQuery(query);
		causeList = await Context.CauseOfDeath.ToListAsync();
		deceasedList = await Context.Deceased.ToListAsync();
		editingDeceased = CloneDeceased(deceasedList[GlobalState.clientID - 1]);
		if (causeList.Any())
		{
			if (queryParameters.TryGetValue("currentRecordString", out var value))
			{
				currentRecordString = value;
				if (int.TryParse(currentRecordString, out var currentRecord))
				{
					currentRecordIndex = currentRecord;
					preVis = currentRecord > 1;
					nexVis = currentRecord < causeList.Count;
				}
			}
			editingCause = CloneCause(currentRecordIndex > 0 ? causeList[currentRecordIndex - 1] : causeList.Last());
		}
	}

	private CauseOfDeath CloneCause(CauseOfDeath original)
	{
		return new CauseOfDeath
		{
			Id = original.Id,
			Manner = original.Manner,
			Other = original.Other,
			CauseFactors = original.CauseFactors,
			OtherFactors = original.OtherFactors,
			TypeofFactor = original.TypeofFactor,
			Diabetic = original.Diabetic,
			DContributed = original.DContributed,
			TobaccoUse = original.TobaccoUse,
			AlcoholUse = original.AlcoholUse,
			Hospitalized = original.Hospitalized,
			DefferedDiag = original.DefferedDiag,
			CommDisease = original.CommDisease,
			DonationConsidered = original.DonationConsidered,
			DonationConsented = original.DonationConsented,
			AnatGiftConsidered = original.AnatGiftConsidered,
			Viewed = original.Viewed,
			Biopsy = original.Biopsy,
			AnatGift = original.AnatGift
		};
	}
	private Deceased CloneDeceased(Deceased original)
	{
		return new Deceased
		{
			ClientID = original.ClientID,
			ServiceID = original.ServiceID,
			Director = original.Director,
			FirstName = original.FirstName,
			LastName = original.LastName,
			MiddleName = original.MiddleName,
			Title = original.Title,
			Suffix = original.Suffix,
			Need = original.Need,
			Status = original.Status,
			StreetAddress = original.StreetAddress,
			City = original.City,
			State = original.State,
			ZipCode = original.ZipCode,
			ContractBalance = original.ContractBalance,
			DoD = original.DoD,
			TimeOfDeath = original.TimeOfDeath,
			SSN = original.SSN,
			Gender = original.Gender,
			MaidenName = original.MaidenName,
			Alias = original.Alias,
			Vet = original.Vet,
			War = original.War,
			InformantName = original.InformantName,
			IStreetAddress = original.IStreetAddress,
			ICity = original.ICity,
			IState = original.IState,
			IZipCode = original.IZipCode,
			IPhoneNumber = original.IPhoneNumber,
			InformantEmail = original.InformantEmail,
			InfoNotified = original.InfoNotified,
			Notes = original.Notes,
			Image = original.Image,
			InformantRelation = original.InformantRelation,
			DoB = original.DoB,
			Age = original.Age,
			BCity = original.BCity,
			BZip = original.BZip,
			BCounty = original.BCounty,
			BState = original.BState,
			BCountry = original.BCountry,
			MStatus = original.MStatus,
			MDate = original.MDate,
			MPlace = original.MPlace,
			Church = original.Church,
			RPreference = original.RPreference,
			Clergy = original.Clergy,
			HighSchool = original.HighSchool,
			HYoE = original.HYoE,
			HEL = original.HEL,
			College = original.College,
			CYoE = original.CYoE,
			CEL = original.CEL
		};
	}

	private async Task SaveRecord()
	{
		var entity = await Context.CauseOfDeath.FirstOrDefaultAsync(e => e.Id == editingCause.Id);
		if (entity is not null)
		{
			entity.Id = editingCause.Id;
			entity.Manner = editingCause.Manner;
			entity.Other = editingCause.Other;
			entity.CauseFactors = editingCause.CauseFactors;
			entity.OtherFactors = editingCause.OtherFactors;
			entity.TypeofFactor = editingCause.TypeofFactor;
			entity.Diabetic = editingCause.Diabetic;
			entity.DContributed = editingCause.DContributed;
			entity.TobaccoUse = editingCause.TobaccoUse;
			entity.AlcoholUse = editingCause.AlcoholUse;
			entity.Hospitalized = editingCause.Hospitalized;
			entity.DefferedDiag = editingCause.DefferedDiag;
			entity.CommDisease = editingCause.CommDisease;
			entity.DonationConsidered = editingCause.DonationConsidered;
			entity.DonationConsented = editingCause.DonationConsented;
			entity.AnatGiftConsidered = editingCause.AnatGiftConsidered;
			entity.Viewed = editingCause.Viewed;
			entity.Biopsy = editingCause.Biopsy;
			entity.AnatGift = editingCause.AnatGift;

			await Context.SaveChangesAsync();
		}
	}
}
