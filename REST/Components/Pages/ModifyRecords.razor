@page "/Modify Records"

@inject RESTDB.Data.ApplicationDbContext Context
@inject NavigationManager NavigationManager
@inject REST.Services.GlobalState GlobalState

@rendermode InteractiveServer

@using Microsoft.Extensions.Primitives
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using RESTDB.Models

<PageTitle>Modify Records</PageTitle>

<div class="title-bar">
	<h1>Modifying Record</h1>

	<div class="SubmitRecordButton">
		<EditForm id="placeholderformid" Model="@editingDeceased" OnValidSubmit="SaveRecord" FormName="placeholderformname" class="placeholderclass">
			<div>
				<InputText id="testsave" class="fcall" @bind-Value="placeholder" style="display: none" />
			</div>
			<div class="SaveButtonFirst">
				<button type="submit" class="btn btn-primary btn-submit" style="background-color: #936091;">Save</button>
			</div>
		</EditForm>
	</div>
</div>

<!-- Tabs Navigation -->
<div class="TabForm">
	<div class="tab-buttons">
		<button @onclick="@(() => SelectTab("Primary Info"))"
				class="tab-button @(selectedTab == "Primary Info" ? "active" : "")">
			Primary Info
		</button>
		<button @onclick="@(() => SelectTab("Secondary Info"))"
				class="tab-button @(selectedTab == "Secondary Info" ? "active" : "")">
			Secondary Info
		</button>
	</div>
</div>

<!-- Tab Content -->
<div class="Tabinfoform">
	@if (selectedTab == "Primary Info")
	{
		<!-- Contact Form -->
		<div class="ContactForm">
			<EditForm id="ContactForm" Model="@editingDeceased" FormName="ContactForm" class="ContactForm">
				<h5>First Call Information</h5>
				<div class="FirstCallTop-group">
					<div class="FirstCall-group1">
						<label for="Director">Director</label>
						<InputSelect @bind-Value="editingDeceased.Director" class="State-group" TValue="string">
							<option value="Denise Adamson">Denise Adamson</option>
							<option value="Jon Hoopert">Jon Hoopert</option>
							<option value="James Groesbeck">James Groesbeck</option>
							<option value="John Heim">John Heim</option>
						</InputSelect>
					</div>
					<div class="FirstCall-group1">
						<label for="Status">Case Status:</label>
						<InputText id="Status" class="fcall" @bind-Value="editingDeceased.Status" />
					</div>
					<div class="ShowImage">
						@if (editingDeceased.Image != null)
						{
							<img src="@($"data:image/png;base64,{Convert.ToBase64String(editingDeceased.Image)}")" style="max-width: 260px; max-height: 258px; width: auto; height: auto; display: block; padding-bottom: 1rem;" alt="Uploaded Image" />
						}
					</div>
				</div>
			</EditForm>
		</div>

		<!-- Deceased Form -->
		<div class="DeceasedForm">
			<EditForm id="DeceasedForm" Model="@editingDeceased" FormName="DeceasedForm" class="DeceasedForm">
				<h5>Deceased Information</h5>
				<div class="FirstCall-group">
					<div class="FirstCall-group1">
						<label for="FirstName">First Name:</label>
						<InputText id="FirstName" class="fcall" @bind-Value="editingDeceased.FirstName" />
					</div>
					<div class="FirstCall-group1">
						<label for="LastName">Last Name:</label>
						<InputText id="LastName" class="fcall" @bind-Value="editingDeceased.LastName" />
					</div>
					<div class="FirstCall-group1">
						<label for="MiddleName">Middle Name:</label>
						<InputText id="MiddleName" class="fcall" @bind-Value="editingDeceased.MiddleName" />
					</div>
					<div class="FirstCall-group1">
						<label for="Title">Title:</label>
						<InputText id="Title" class="fcall" @bind-Value="editingDeceased.Title" />
					</div>
					<div class="FirstCall-group1">
						<label for="DoD">Date of Death:</label>
						<InputDate id="DoD" class="fcall" @bind-Value="editingDeceased.DoD" />
					</div>
					<div class="FirstCall-group1">
						<label for="TimeOfDeath">Time of Death:</label>
						<input type="time" class="fcall" @bind="editingDeceased.TimeOfDeath" />
					</div>
					<div class="FirstCall-group1">
						<label for="Alias">Alias:</label>
						<InputText id="Alias" class="fcall" @bind-Value="editingDeceased.Alias" />
					</div>
					<div class="FirstCall-group1">
						<label for="StreetAddress">Street Address:</label>
						<InputText id="StreetAddress" class="fcall" @bind-Value="editingDeceased.StreetAddress" />
					</div>
					<div class="FirstCall-group1">
						<label for="City">City:</label>
						<InputText id="City" class="fcall" @bind-Value="editingDeceased.City" />
					</div>
					<div class="IState-container">
						<label for="State">Select State:</label>
