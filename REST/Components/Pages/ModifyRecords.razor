@page "/Modify Records"
@inject RESTDB.Data.ApplicationDbContext Context
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@using Microsoft.Extensions.Primitives
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components

<PageTitle>Modify Records</PageTitle>

<h1>Modify Records</h1>

<div class="ContactForm">
	<EditForm id="ContactForm" Model="@currentDeceased" FormName="ContactForm" class="ContactForm">
		<h5>First Call Information</h5>
		<div class="FirstCall-group">
			<!-- Director -->
			<div class="FirstCall-group1">
				<label for="Director">Director</label>
				<InputSelect @bind-Value="currentDeceased.Director" class="State-group" TValue="string">
						<option value="Travis">Denise Adamson</option>
						<option value="Nolan">Jon Hoopert</option>
						<option value="Kevin">James Groesbeck</option>
				</InputSelect>
			</div>
			<!-- Case Status -->
			<div class="FirstCall-group1">
				<label for="Status">Case Status:</label>
				<InputText id="Status" class="fcall" @bind-Value="currentDeceased.Status" />
			</div>
		</div>
	</EditForm>
</div>

<div class="DeceasedForm">
	<EditForm id="DeceasedForm" Model="@currentDeceased" FormName="DeceasedForm" class="DeceasedForm">
		<h5>Deceased Information</h5>
		<div class="FirstCall-group">
			<!-- First Name -->
			<div class="FirstCall-group1">
				<label for="FirstName">First Name:</label>
				<InputText id="FirstName" class="fcall" @bind-Value="currentDeceased.FirstName" />
			</div>
			<!-- Last Name -->
			<div class="FirstCall-group1">
				<label for="LastName">Last Name:</label>
				<InputText id="LastName" class="fcall" @bind-Value="currentDeceased.LastName" />
			</div>
			<!-- Middle Name -->
			<div class="FirstCall-group1">
				<label for="MiddleName">Middle Name:</label>
				<InputText id="MiddleName" class="fcall" @bind-Value="currentDeceased.MiddleName" />
			</div>
			<!-- Title -->
			<div class="FirstCall-group1">
				<label for="Title">Title:</label>
				<InputText id="Title" class="fcall" @bind-Value="currentDeceased.Title" />
			</div>

			<!-- Date of Death -->
			<div class="FirstCall-group1">
				<label for="DoD">Date of Death:</label>
				<InputDate id="DoD" class="fcall" @bind-Value="currentDeceased.DoD" />
			</div>
			<!-- Time of Death -->
			<div class="FirstCall-group1">
				<label for="TimeOfDeath">Time of Death:</label>
				<input type="time" class="fcall" @bind="currentDeceased.TimeOfDeath" />
			</div>
