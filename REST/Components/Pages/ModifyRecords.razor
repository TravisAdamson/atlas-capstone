@code {
	private List<Deceased> Deceased = new List<Deceased>();
	private Deceased currentDeceased = new Deceased();
	private Deceased edittingDeceased = new Deceased();

	private string? PhonePart1 { get; set; }
	private string? PhonePart2 { get; set; }
	private string? PhonePart3 { get; set; }

	private string? SSNPart1 { get; set; }
	private string? SSNPart2 { get; set; }
	private string? SSNPart3 { get; set; }
	private int currentRecordIndex = 0;
	private string? currentRecordString;
	private string? placeholder { get; set; }




	protected override async Task OnInitializedAsync()
	{

		var uri = NavigationManager.Uri;
		var query = new Uri(uri).Query;
		var queryParameters = QueryHelpers.ParseQuery(query);

		Deceased = await Context.Deceased.ToListAsync();
		if (Deceased.Any())
		{
			if (queryParameters.TryGetValue("currentRecordString", out var value))
			{
				currentRecordString = value;
				if (int.TryParse(currentRecordString, out var currentRecord))
				{
					if (currentRecord == Deceased.Count)
						currentRecordIndex = currentRecord;
				}
			}
			if (currentRecordIndex != 0)
				edittingDeceased = CloneDeceased(Deceased[currentRecordIndex - 1]);
			else
				edittingDeceased = CloneDeceased(Deceased.Last());
			LoadDigits();
		}
	}

	private void GoToBuyers(int clientID)
	{
		NavigationManager.NavigateTo($"/ModifyBuyer");
	}


	private Deceased CloneDeceased(Deceased original)
	{
		return new Deceased
		{
			ClientID = original.ClientID,
			Director = original.Director,
			FirstName = original.FirstName,
			LastName = original.LastName,
			MiddleName = original.MiddleName,
			Title = original.Title,
			Suffix = original.Suffix,
			Status = original.Status,
			StreetAddress = original.StreetAddress,
			City = original.City,
			State = original.State,
			ZipCode = original.ZipCode,
			ContractBalance = original.ContractBalance,
			DoD = original.DoD,
			TimeOfDeath = original.TimeOfDeath,
			SSN = original.SSN,
			Gender = original.Gender,
			MaidenName = original.MaidenName,
			Alias = original.Alias,
			Vet = original.Vet,
			War = original.War,
			InformantName = original.InformantName,
			IStreetAddress = original.IStreetAddress,
			ICity = original.ICity,
			IState = original.IState,
			IZipCode = original.IZipCode,
			IPhoneNumber = original.IPhoneNumber,
			InformantEmail = original.InformantEmail,
			InfoNotified = original.InfoNotified,
			Notes = original.Notes,
			Image = original.Image,
			InformantRelation = original.InformantRelation
		};
	}

	private int GetNextClientID()
	{
		var lastDeceased = Context.Deceased.OrderByDescending(d => d.ClientID).FirstOrDefault();
		return lastDeceased?.ClientID + 1 ?? 1;
	}

	private void LoadDigits()
	{
		if (!string.IsNullOrEmpty(edittingDeceased.SSN))
		{
			var ssnParts = edittingDeceased.SSN.Split('-');
			if (ssnParts.Length == 3)
			{
				SSNPart1 = ssnParts[0];
				SSNPart2 = ssnParts[1];
				SSNPart3 = ssnParts[2];
			}
		}

		if (!string.IsNullOrEmpty(edittingDeceased.IPhoneNumber))
		{
			var phoneNumber = edittingDeceased.IPhoneNumber
				.Replace("(", "")
				.Replace(")", "")
				.Replace("-", "");

			if (phoneNumber.Length == 10)
			{
				PhonePart1 = phoneNumber.Substring(0, 3);
				PhonePart2 = phoneNumber.Substring(3, 3);
				PhonePart3 = phoneNumber.Substring(6, 4);
			}
		}
	}
	private async Task HandleImageUpload(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file != null)
		{
			try
			{
				using (var memoryStream = new MemoryStream())
				{
					await file.OpenReadStream().CopyToAsync(memoryStream);
					edittingDeceased.Image = memoryStream.ToArray(); // Store the image as a byte array
				}
			}
			catch (Exception ex)
			{
				Console.WriteLine($"Error uploading image: {ex.Message}");
			}
		}
	}

	private async Task SaveRecord()
	{
		var entity = await Context.Deceased.FirstOrDefaultAsync(d => d.ClientID == edittingDeceased.ClientID);

		if (string.IsNullOrEmpty(edittingDeceased.FirstName) || string.IsNullOrEmpty(edittingDeceased.LastName))
		{
			Console.WriteLine("First Name and Last Name are required.");
			return;
		}

		// Format SSN
		if (string.IsNullOrEmpty(SSNPart1) || string.IsNullOrEmpty(SSNPart2) || string.IsNullOrEmpty(SSNPart3))
		{
			Console.WriteLine("SSN is required.");
		}
		else
			edittingDeceased.SSN = $"{SSNPart1}-{SSNPart2}-{SSNPart3}";

		// Format Phone Number
		if (string.IsNullOrEmpty(PhonePart1) || string.IsNullOrEmpty(PhonePart2) || string.IsNullOrEmpty(PhonePart3))
		{
			Console.WriteLine("Phone number is required.");
		}
		else
			edittingDeceased.IPhoneNumber = $"({PhonePart1}){PhonePart2}-{PhonePart3}";

		// Save
		if (entity is not null)
		{
			entity.ClientID = edittingDeceased.ClientID;
			entity.Director = edittingDeceased.Director;
			entity.FirstName = edittingDeceased.FirstName;
			entity.LastName = edittingDeceased.LastName;
			entity.MiddleName = edittingDeceased.MiddleName;
			entity.Title = edittingDeceased.Title;
			entity.Suffix = edittingDeceased.Suffix;
			entity.Status = edittingDeceased.Status;
			entity.StreetAddress = edittingDeceased.StreetAddress;
			entity.City = edittingDeceased.City;
			entity.State = edittingDeceased.State;
			entity.ZipCode = edittingDeceased.ZipCode;
			entity.ContractBalance = edittingDeceased.ContractBalance;
			entity.DoD = edittingDeceased.DoD;
			entity.TimeOfDeath = edittingDeceased.TimeOfDeath;
			entity.SSN = edittingDeceased.SSN;
			entity.Gender = edittingDeceased.Gender;
			entity.MaidenName = edittingDeceased.MaidenName;
			entity.Alias = edittingDeceased.Alias;
			entity.Vet = edittingDeceased.Vet;
			entity.War = edittingDeceased.War;
			entity.InformantName = edittingDeceased.InformantName;
			entity.IStreetAddress = edittingDeceased.IStreetAddress;
			entity.ICity = edittingDeceased.ICity;
			entity.IState = edittingDeceased.IState;
			entity.IZipCode = edittingDeceased.IZipCode;
			entity.IPhoneNumber = edittingDeceased.IPhoneNumber;
			entity.InformantEmail = edittingDeceased.InformantEmail;
			entity.InfoNotified = edittingDeceased.InfoNotified;
			entity.Notes = edittingDeceased.Notes;
			entity.Image = edittingDeceased.Image;
			entity.InformantRelation = edittingDeceased.InformantRelation;
		}
		await Context.SaveChangesAsync();
	}

	<!-- Page Navigation -->
	private void NavigateToContract()
	{
		if (edittingDeceased?.ClientID > 0)
			NavigationManager.NavigateTo($"/Contract?currentRecordString={edittingDeceased.ClientID}");
	}

	private void NavigateToMilitary()
	{
		if (edittingDeceased?.ClientID > 0)
			NavigationManager.NavigateTo($"/Military?currentRecordString={edittingDeceased.ClientID}");
	}

	private void NavigateToPlaceOfDeath()
	{
		if (edittingDeceased?.ClientID > 0)
			NavigationManager.NavigateTo($"/PlaceOfDeath?currentRecordString={edittingDeceased.ClientID}");
	}
	private void NavigateToObituary()
	{
		if (edittingDeceased?.ClientID > 0)
			NavigationManager.NavigateTo($"/Obituary?currentRecordString={edittingDeceased.ClientID}");
	}
	private void NavigateToEmbalmer()
	{
		if (edittingDeceased?.ClientID > 0)
			NavigationManager.NavigateTo($"/Embalmer?currentRecordString={edittingDeceased.ClientID}");
