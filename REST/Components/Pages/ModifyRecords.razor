								oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
					</div>
					<!-- SSN -->
					<div class="FirstCall-group1">
						<label for="SSN">SSN:</label>
						<div class="SSN-input">
							<InputText id="SSNPart1" class="numcall1" maxlength="3" @bind-Value="SSNPart1" placeholder="###" />
							<span>-</span>
							<InputText id="SSNPart2" class="numcall2" maxlength="2" @bind-Value="SSNPart2" placeholder="##" />
							<span>-</span>
							<InputText id="SSNPart3" class="numcall3" maxlength="4" @bind-Value="SSNPart3" placeholder="####" />
						</div>
					</div>
					<div class="FirstCall-group1">
						<label for="MaidenName">Maiden Name:</label>
						<InputText id="MaidenName" class="fcall" @bind-Value="editingDeceased.MaidenName" />
					</div>
					<div class="FirstCall-group1">
						<label for="Vet">Veteran Status:</label>
						<InputText id="Vet" class="fcall" @bind-Value="editingDeceased.Vet" />
					</div>
					<div class="FirstCall-group1">
						<label for="War">War Served:</label>
						<InputText id="War" class="fcall" @bind-Value="editingDeceased.War" />
					</div>
					<div class="suffix-container">
						<label for="suffix">Suffix:</label>
						<InputText id="suffix" class="fcall" @bind-Value="editingDeceased.Suffix" />
					</div>
					<div class="gender-container">
						<label>Gender:</label>
						<InputSelect @bind-Value="editingDeceased.Gender" class="gender-group" TValue="string">
							<option value="Male">Male</option>
							<option value="Female">Female</option>
						</InputSelect>
					</div>
					<div class="FirstCall-group1">
						<label for="Notes">Notes:</label>
						<InputTextArea id="Notes" class="fcall notes-field" @bind-Value="editingDeceased.Notes" />
					</div>
					<div class="FirstCall-group1">
						<label for="ImageUpload">Upload Image:</label>
						<InputFile id="ImageUpload" OnChange="HandleImageUpload" class="ImageUpload" />
					</div>
				</div>
			</EditForm>
		</div>

		<!-- Informant Form -->
		<div class="InformantForm">
			<EditForm id="InformantForm" Model="@editingDeceased" FormName="InformantForm" class="InformantForm">
				<h5>Informant Information</h5>
				<div class="FirstCall-group">
					<div class="FirstCall-group1">
						<label for="InformantName">Informant Name:</label>
						<InputText id="InformantName" class="fcall" @bind-Value="editingDeceased.InformantName" />
					</div>
					<div class="FirstCall-group1">
						<label for="IStreetAddress">Informant Street Address:</label>
						<InputText id="IStreetAddress" class="fcall" @bind-Value="editingDeceased.IStreetAddress" />
					</div>
					<div class="FirstCall-group1">
						<label for="ICity">Informant City:</label>
						<InputText id="ICity" class="fcall" @bind-Value="editingDeceased.ICity" />
					</div>
					<div class="IState-container">
						<label for="IState">Select State:</label>
						<InputSelect @bind-Value="editingDeceased.IState" class="IState-group" TValue="string">
							<option value="Alabama">Alabama</option>
							<option value="Alaska">Alaska</option>
							<option value="Arizona">Arizona</option>
							<option value="Arkansas">Arkansas</option>
							<option value="California">California</option>
							<option value="Colorado">Colorado</option>
							<option value="Connecticut">Connecticut</option>
							<option value="Delaware">Delaware</option>
							<option value="Florida">Florida</option>
							<option value="Georgia">Georgia</option>
							<option value="Hawaii">Hawaii</option>
							<option value="Idaho">Idaho</option>
							<option value="Illinois">Illinois</option>
							<option value="Indiana">Indiana</option>
							<option value="Iowa">Iowa</option>
							<option value="Kansas">Kansas</option>
							<option value="Kentucky">Kentucky</option>
							<option value="Louisiana">Louisiana</option>
							<option value="Maine">Maine</option>
							<option value="Maryland">Maryland</option>
							<option value="Massachusetts">Massachusetts</option>
							<option value="Michigan">Michigan</option>
							<option value="Minnesota">Minnesota</option>
							<option value="Mississippi">Mississippi</option>
							<option value="Missouri">Missouri</option>
							<option value="Montana">Montana</option>
							<option value="Nebraska">Nebraska</option>
							<option value="Nevada">Nevada</option>
							<option value="New Hampshire">New Hampshire</option>
							<option value="New Jersey">New Jersey</option>
							<option value="New Mexico">New Mexico</option>
							<option value="New York">New York</option>
							<option value="North Carolina">North Carolina</option>
							<option value="North Dakota">North Dakota</option>
							<option value="Ohio">Ohio</option>
							<option value="Oklahoma">Oklahoma</option>
							<option value="Oregon">Oregon</option>
							<option value="Pennsylvania">Pennsylvania</option>
							<option value="Rhode Island">Rhode Island</option>
							<option value="South Carolina">South Carolina</option>
							<option value="South Dakota">South Dakota</option>
							<option value="Tennessee">Tennessee</option>
							<option value="Texas">Texas</option>
							<option value="Utah">Utah</option>
							<option value="Vermont">Vermont</option>
							<option value="Virginia">Virginia</option>
							<option value="Washington">Washington</option>
							<option value="West Virginia">West Virginia</option>
							<option value="Wisconsin">Wisconsin</option>
							<option value="Wyoming">Wyoming</option>
							<option value="District of Columbia">District of Columbia</option>
						</InputSelect>
					</div>
					<div class="FirstCall-group1">
						<label for="IZipcode">Informant Zip Code:</label>
						<InputText id="IZipCode"
								class="zipcall"
								@bind-Value="editingDeceased.IZipCode"
								inputmode="numeric"
								pattern="[0-9]*"
								maxlength="5"
								oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
					</div>
					<div class="FirstCall-group1">
						<label for="IPhoneNumber">Phone Number:</label>
						<div class="Phone-input">
							<InputText id="PhonePart1" class="numcall1" maxlength="3" @bind-Value="PhonePart1" placeholder="###" />
							<span>-</span>
							<InputText id="PhonePart2" class="numcall2" maxlength="3" @bind-Value="PhonePart2" placeholder="###" />
							<span>-</span>
							<InputText id="PhonePart3" class="numcall3" maxlength="4" @bind-Value="PhonePart3" placeholder="####" />
						</div>
					</div>
					<div class="FirstCall-group1">
						<label for="InformantEmail">Email Address:</label>
						<InputText id="InformantEmail" class="fcall" @bind-Value="editingDeceased.InformantEmail" />
					</div>
				</div>
				<div class="FirstCall-group">
					<div class="FirstCall-group1">
						<label for="InformantRelation">Relation to Deceased:</label>
						<InputText id="InformantRelation" class="fcall" @bind-Value="editingDeceased.InformantRelation" />
					</div>
					<div class="FirstCall-group1">
						<label for="InfoNotified">Date Notified:</label>
						<InputDate id="InfoNotified" class="fcall" @bind-Value="editingDeceased.InfoNotified" />
					</div>
				</div>
			</EditForm>
		</div>
	}
	else if (selectedTab == "Secondary Info")
	{
		<h5>Secondary Info</h5>
		<p>placeholder</p>
	}
</div>

@code {
	// Fields
	private List<Deceased> Deceased = new List<Deceased>();
	private Deceased editingDeceased = new Deceased();

	private string? PhonePart1 { get; set; }
	private string? PhonePart2 { get; set; }
	private string? PhonePart3 { get; set; }

	private string? SSNPart1 { get; set; }
	private string? SSNPart2 { get; set; }
	private string? SSNPart3 { get; set; }

	private int currentRecordIndex = 0;
	private string? currentRecordString;
	private string? placeholder { get; set; }

	// Tab logic
	private string selectedTab = "Primary Info";

	private void SelectTab(string tabName)
	{
		selectedTab = tabName;
	}

	protected override async Task OnInitializedAsync()
	{
		var uri = NavigationManager.Uri;
		var query = new Uri(uri).Query;
		var queryParameters = QueryHelpers.ParseQuery(query);

		Deceased = await Context.Deceased.ToListAsync();
		if (Deceased.Any())
		{
			if (queryParameters.TryGetValue("currentRecordString", out var value))
			{
				currentRecordString = value;
				if (int.TryParse(currentRecordString, out var currentRecord))
				{
					if (currentRecord == Deceased.Count)
						currentRecordIndex = currentRecord;
				}
			}
			if (currentRecordIndex != 0)
				editingDeceased = CloneDeceased(Deceased[currentRecordIndex - 1]);
			else
				editingDeceased = CloneDeceased(Deceased.Last());

			LoadDigits();
		}
	}

	private Deceased CloneDeceased(Deceased original)
	{
		return new Deceased
		{
			ClientID = original.ClientID,
			Director = original.Director,
			FirstName = original.FirstName,
			LastName = original.LastName,
			MiddleName = original.MiddleName,
			Title = original.Title,
			Suffix = original.Suffix,
			Status = original.Status,
			StreetAddress = original.StreetAddress,
			City = original.City,
			State = original.State,
			ZipCode = original.ZipCode,
			ContractBalance = original.ContractBalance,
			DoD = original.DoD,
			TimeOfDeath = original.TimeOfDeath,
			SSN = original.SSN,
			Gender = original.Gender,
			MaidenName = original.MaidenName,
			Alias = original.Alias,
			Vet = original.Vet,
			War = original.War,
			InformantName = original.InformantName,
			IStreetAddress = original.IStreetAddress,
			ICity = original.ICity,
			IState = original.IState,
			IZipCode = original.IZipCode,
			IPhoneNumber = original.IPhoneNumber,
			InformantEmail = original.InformantEmail,
			InfoNotified = original.InfoNotified,
			Notes = original.Notes,
			Image = original.Image,
			InformantRelation = original.InformantRelation
		};
	}

	private void LoadDigits()
	{
		// SSN
		if (!string.IsNullOrEmpty(editingDeceased.SSN))
		{
			var ssnParts = editingDeceased.SSN.Split('-');
			if (ssnParts.Length == 3)
			{
				SSNPart1 = ssnParts[0];
				SSNPart2 = ssnParts[1];
				SSNPart3 = ssnParts[2];
			}
		}
		// Phone
		if (!string.IsNullOrEmpty(editingDeceased.IPhoneNumber))
		{
			var phoneNumber = editingDeceased.IPhoneNumber
				.Replace("(", "")
				.Replace(")", "")
				.Replace("-", "");

			if (phoneNumber.Length == 10)
			{
				PhonePart1 = phoneNumber.Substring(0, 3);
				PhonePart2 = phoneNumber.Substring(3, 3);
				PhonePart3 = phoneNumber.Substring(6, 4);
			}
		}
	}

	private async Task HandleImageUpload(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file != null)
		{
			try
			{
				using var memoryStream = new MemoryStream();
				await file.OpenReadStream().CopyToAsync(memoryStream);
				editingDeceased.Image = memoryStream.ToArray();
			}
			catch (Exception ex)
			{
				Console.WriteLine($"Error uploading image: {ex.Message}");
			}
		}
	}

	private async Task SaveRecord()
	{
		var entity = await Context.Deceased.FirstOrDefaultAsync(d => d.ClientID == editingDeceased.ClientID);

		// Basic validation
		if (string.IsNullOrEmpty(editingDeceased.FirstName) || string.IsNullOrEmpty(editingDeceased.LastName))
		{
			Console.WriteLine("First Name and Last Name are required.");
			return;
		}

		// Format SSN
		if (string.IsNullOrEmpty(SSNPart1) || string.IsNullOrEmpty(SSNPart2) || string.IsNullOrEmpty(SSNPart3))
		{
			Console.WriteLine("SSN is required.");
		}
		else
		{
			editingDeceased.SSN = $"{SSNPart1}-{SSNPart2}-{SSNPart3}";
		}

		// Format Phone
		if (string.IsNullOrEmpty(PhonePart1) || string.IsNullOrEmpty(PhonePart2) || string.IsNullOrEmpty(PhonePart3))
		{
			Console.WriteLine("Phone number is required.");
		}
		else
		{
			editingDeceased.IPhoneNumber = $"({PhonePart1}){PhonePart2}-{PhonePart3}";
		}

		// Save to DB
		if (entity is not null)
		{
			entity.ClientID = editingDeceased.ClientID;
			entity.Director = editingDeceased.Director;
			entity.FirstName = editingDeceased.FirstName;
			entity.LastName = editingDeceased.LastName;
			entity.MiddleName = editingDeceased.MiddleName;
			entity.Title = editingDeceased.Title;
			entity.Suffix = editingDeceased.Suffix;
			entity.Status = editingDeceased.Status;
			entity.StreetAddress = editingDeceased.StreetAddress;
			entity.City = editingDeceased.City;
			entity.State = editingDeceased.State;
			entity.ZipCode = editingDeceased.ZipCode;
			entity.ContractBalance = editingDeceased.ContractBalance;
			entity.DoD = editingDeceased.DoD;
			entity.TimeOfDeath = editingDeceased.TimeOfDeath;
			entity.SSN = editingDeceased.SSN;
			entity.Gender = editingDeceased.Gender;
			entity.MaidenName = editingDeceased.MaidenName;
			entity.Alias = editingDeceased.Alias;
			entity.Vet = editingDeceased.Vet;
			entity.War = editingDeceased.War;
			entity.InformantName = editingDeceased.InformantName;
			entity.IStreetAddress = editingDeceased.IStreetAddress;
			entity.ICity = editingDeceased.ICity;
			entity.IState = editingDeceased.IState;
			entity.IZipCode = editingDeceased.IZipCode;
			entity.IPhoneNumber = editingDeceased.IPhoneNumber;
			entity.InformantEmail = editingDeceased.InformantEmail;
			entity.InfoNotified = editingDeceased.InfoNotified;
			entity.Notes = editingDeceased.Notes;
			entity.Image = editingDeceased.Image;
			entity.InformantRelation = editingDeceased.InformantRelation;

			await Context.SaveChangesAsync();
		}
	}
}

