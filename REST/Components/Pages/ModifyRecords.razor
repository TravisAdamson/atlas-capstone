	private void LoadDigits()
	{
		// SSN
		if (!string.IsNullOrEmpty(editingDeceased.SSN))
		{
			var ssnParts = editingDeceased.SSN.Split('-');
			if (ssnParts.Length == 3)
			{
				SSNPart1 = ssnParts[0];
				SSNPart2 = ssnParts[1];
				SSNPart3 = ssnParts[2];
			}
		}
		// Phone
		if (!string.IsNullOrEmpty(editingDeceased.IPhoneNumber))
		{
			var phoneNumber = editingDeceased.IPhoneNumber
				.Replace("(", "")
				.Replace(")", "")
				.Replace("-", "");

			if (phoneNumber.Length == 10)
			{
				PhonePart1 = phoneNumber.Substring(0, 3);
				PhonePart2 = phoneNumber.Substring(3, 3);
				PhonePart3 = phoneNumber.Substring(6, 4);
			}
		}
	}

	private async Task HandleImageUpload(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file != null)
		{
			try
			{
				using var memoryStream = new MemoryStream();
				await file.OpenReadStream().CopyToAsync(memoryStream);
				editingDeceased.Image = memoryStream.ToArray();
			}
			catch (Exception ex)
			{
				Console.WriteLine($"Error uploading image: {ex.Message}");
			}
		}
	}

	private async Task SaveRecord()
	{

		if (string.IsNullOrEmpty(editingDeceased.FirstName) || string.IsNullOrEmpty(editingDeceased.LastName))
		{
			Console.WriteLine("First Name and Last Name are required.");
			return;
		}

		// Format SSN
		if (string.IsNullOrEmpty(SSNPart1) || string.IsNullOrEmpty(SSNPart2) || string.IsNullOrEmpty(SSNPart3))
		{
			Console.WriteLine("SSN is required.");
		}
		else
		{
			editingDeceased.SSN = $"{SSNPart1}-{SSNPart2}-{SSNPart3}";
		}

		// Format Phone
		if (string.IsNullOrEmpty(PhonePart1) || string.IsNullOrEmpty(PhonePart2) || string.IsNullOrEmpty(PhonePart3))
		{
			Console.WriteLine("Phone number is required.");
		}
		else
		{
			editingDeceased.IPhoneNumber = $"({PhonePart1}){PhonePart2}-{PhonePart3}";
		}

        if (existingDeceased != null && editingDeceased != null)
        {
			try
			{
				Db.Entry(existingDeceased).CurrentValues.SetValues(editingDeceased);

				// Replace nav collections
				ReplaceCollection(existingDeceased.Airline, editingDeceased.Airline);
				ReplaceCollection(existingDeceased.Buyer, editingDeceased.Buyer);
				ReplaceCollection(existingDeceased.CashAdvance, editingDeceased.CashAdvance);
				ReplaceCollection(existingDeceased.CauseOfDeath, editingDeceased.CauseOfDeath);
				ReplaceCollection(existingDeceased.ContainerShipping, editingDeceased.ContainerShipping);
				ReplaceCollection(existingDeceased.Embalmer, editingDeceased.Embalmer);
				ReplaceCollection(existingDeceased.FlagApplication, editingDeceased.FlagApplication);
				ReplaceCollection(existingDeceased.Military, editingDeceased.Military);
				ReplaceCollection(existingDeceased.MilitaryStint, editingDeceased.MilitaryStint);
				ReplaceCollection(existingDeceased.Monument, editingDeceased.Monument);
				ReplaceCollection(existingDeceased.ObituaryData, editingDeceased.ObituaryData);
				ReplaceCollection(existingDeceased.PlaceOfDeath, editingDeceased.PlaceOfDeath);
				ReplaceCollection(existingDeceased.Products, editingDeceased.Products);
				ReplaceCollection(existingDeceased.ServiceContract, editingDeceased.ServiceContract);
				ReplaceCollection(existingDeceased.Services, editingDeceased.Services);
				ReplaceCollection(existingDeceased.Survivors, editingDeceased.Survivors);
				ReplaceCollection(existingDeceased.WarsServed, editingDeceased.WarsServed);

				await Db.SaveChangesAsync();
        	}
			catch (DbUpdateException ex)
			{
				// You can inspect the inner exception to make sure it's a duplicate key error
				if (ex.InnerException != null && ex.InnerException.Message.Contains("Duplicate"))
				{
					errorMessage = "A record with this Service ID already exists.";
				}
				else
				{
					errorMessage = "An unexpected error occurred while saving.";
				}
				Console.WriteLine($"Error: {errorMessage}");
				Console.WriteLine($"Error saving record: {ex.Message}");
			}
		}
	}

	private void ReplaceCollection<T>(ICollection<T> original, ICollection<T> updated) where T : class
    {
        original.Clear();
        foreach (var item in updated)
        {
            original.Add(item);
        }
    }
