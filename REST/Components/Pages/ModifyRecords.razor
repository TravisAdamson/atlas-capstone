				<div class="FirstCallTop-group">
					<div class="FirstCall-group1">
						<label for="Director">Director</label>
						<InputSelect @bind-Value="editingDeceased.Director" class="State-group" TValue="string">
								<option disabled value="">Select</option>
								<option value="Denise Adamson">Denise Adamson</option>
								<option value="Jon Hoopert">Jon Hoopert</option>
								<option value="James Groesbeck">James Groesbeck</option>
						</InputSelect>
					</div>
					<!-- Case Status -->
					<div class="FirstCall-group1">
						<label for="Need">Pre-Need or At-Need:</label>
						<InputSelect id="Need" class="State-group" TValue="string" @bind-Value="editingDeceased.Need">
								<option disabled value="">Select</option>
								<option value="Pre-Need">Pre-Need</option>
								<option value="At-Need">At-Need</option>
						</InputSelect>
					</div>
					<div class="FirstCall-group1">
						<label for="Status">Case Status:</label>
						<InputSelect id="Status" class="State-group" TValue="string" @bind-Value="editingDeceased.Status">
								<option disabled value="">Select</option>
								<option value="Pending">Pending</option>
								<option value="Closed">Closed</option>
								<option value="Charged off">Charged off</option>
						</InputSelect>
					</div>
					<div class="FirstCall-group1">
						<label for="ServiceID">Service ID:</label>
						<InputText id="ServiceID" class="UniqueServiceID" @bind-Value="editingDeceased.ServiceID" />
					</div>
					<div class="ShowImage">
						@if (editingDeceased.Image != null)
						{
							<img src="@($"data:image/png;base64,{Convert.ToBase64String(editingDeceased.Image)}")" style="max-width: 244px; max-height: 244px; width: auto; height: auto; display: block; padding-bottom: 1rem;" alt="Uploaded Image" />
						}
					</div>
				</div>
			</EditForm>
		</div>

