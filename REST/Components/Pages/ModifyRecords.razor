@page "/Modify Records"
@inject RESTDB.Data.ApplicationDbContext Context
@rendermode InteractiveServer

<PageTitle>Modify Records</PageTitle>

<h1>Modify Records</h1>

<style>
    /* Keep the styles as they are */
</style>

<EditForm id="ContactForm" Model="@currentDeceased" OnValidSubmit="SaveRecord" FormName="ContactForm" class="ContactForm">
    <h5>FirstCall Information</h5>
    <div class="FirstCall-group">
        <!-- Director -->
        <div class="FirstCall-group1">
            <label for="Director">Director</label>
                <select id="Director" name="Director">
                    <option value="Travis">Travis</option>
                    <option value="Nolan">Nolan</option>
                    <option value="Kevin">Kevin</option>
                    <option value="Matt">Matt</option>
                    <option value="Other">Other</option>
                </select>    
        </div>
        <div class="FirstCall-group">
        <!-- Status -->
        <div class="FirstCall-group1">
            <label for="Status">Status:</label>
            <InputText id="Status" class="fcall" @bind-Value="currentDeceased.Status" />
        </div>
    </div>
    <div class="FirstCall-group">
        <!-- Phone Number -->
        <div class="FirstCall-group1">
            <label for="IPhoneNumber">Informant Phone Number:</label>
            <InputNumber id="IPhoneNumber" class="fcall" @bind-Value="currentDeceased.IPhoneNumber" />
        </div>
    <!-- Informant Email -->
        <div class="FirstCall-group1">
            <label for="InformantEmail">Informant Email:</label>
            <InputText id="InformantEmail" class="fcall" @bind-Value="currentDeceased.InformantEmail" />
        </div>
    </div>

    <div class="FirstCall-group">
        <!-- Info Notified -->
        <div class="FirstCall-group1">
            <label for="InfoNotified">Informant Notified:</label>
            <InputDate id="InfoNotified" class="fcall" @bind-Value="currentDeceased.InfoNotified" />
        </div>
    </div>

    </div>
</EditForm>
<EditForm id="DeceasedForm" Model="@currentDeceased" OnValidSubmit="SaveRecord" FormName="DeceasedForm" class="DeceasedForm">
	<h5>Deceased Information</h5>
	<div class="FirstCall-group">
		<!-- First Name -->
		<div class="FirstCall-group1">
			<label for="FirstName">First Name:</label>
			<InputText id="FirstName" class="fcall" @bind-Value="currentDeceased.FirstName" />
        </div>

        <!-- Last Name -->
        <div class="FirstCall-group1">
            <label for="LastName">Last Name:</label>
            <InputText id="LastName" class="fcall" @bind-Value="currentDeceased.LastName" />
        </div>

        <!-- Middle Name -->
        <div class="FirstCall-group1">
            <label for="MiddleName">Middle Name:</label>
            <InputText id="MiddleName" class="fcall" @bind-Value="currentDeceased.MiddleName" />
        </div>

    
        <!-- Title -->
        <div class="FirstCall-group1">
            <label for="Title">Title:</label>
            <InputText id="Title" class="fcall" @bind-Value="currentDeceased.Title" />
        </div>
            <div class="FirstCall-group">
        <!-- Date of Death -->
        <div class="FirstCall-group1">
            <label for="DoD">Date of Death:</label>
            <InputDate id="DoD" class="fcall" @bind-Value="currentDeceased.DoD" />
        </div>

        <!-- Time of Death -->
        <div class="FirstCall-group1">
            <label for="TimeOfDeath">Time of Death:</label>
            <InputDate id="TimeOfDeath" class="fcall" @bind-Value="currentDeceased.TimeOfDeath" />
        </div>
                    <!-- Alias -->
        <div class="FirstCall-group1">
            <label for="Alias">Alias:</label>
            <InputText id="Alias" class="fcall" @bind-Value="currentDeceased.Alias" />
        </div>
    </div>

    </div>
    <div class="FirstCall-group">
                <!-- SSN -->
        <div class="FirstCall-group1">
            <label for="SSN">SSN:</label>
            <InputNumber id="SSN" class="fcall" @bind-Value="currentDeceased.SSN" placeholder="123-45-6789" pattern="\d{3}-\d{2}-\d{4}" title="Format: 123-45-6789" maxlength="11" @oninput="FormatSSN" />
        </div>


    <div class="FirstCall-group">
        <!-- Maiden Name -->
        <div class="FirstCall-group1">
            <label for="MaidenName">Maiden Name:</label>
            <InputText id="MaidenName" class="fcall" @bind-Value="currentDeceased.MaidenName" />
        </div>

                <!-- Vet -->
        <div class="FirstCall-group1">
            <label for="Vet">Veteran Status (0 = No, 1 = Yes):</label>
            <InputText id="Vet" class="fcall" @bind-Value="currentDeceased.Vet" />
        </div>
            <div class="FirstCall-group">
        <!-- War -->
        <div class="FirstCall-group1">
            <label for="War">War Served:</label>
            <InputText id="War" class="fcall" @bind-Value="currentDeceased.War" />
        </div>
        </div>
        <!-- Suffix -->
        <div class="suffix-container">
            <label for="suffix">Select Suffix:</label>
            <InputRadioGroup @bind-Value="currentDeceased.Suffix" class="suffix-group">
                <InputRadio id="MR" TValue="string" value="MR" class="fcall" /> MR.
                <InputRadio id="MRS" TValue="string" value="MRS" class="fcall" /> MRS.
                <InputRadio id="DR" TValue="string" value="DR" class="fcall" /> DR.
            </InputRadioGroup>
        </div>

                </div>
        <!-- Display Image -->
        <div class="display-img">
            <div>
                <img class="img-class">
            </div>
        </div>
        <!-- Gender -->
        <div class="gender-container">
            <label>Gender:</label>
            <InputRadioGroup @bind-Value="currentDeceased.Gender" class="gender-group">
                <InputRadio id="Male" TValue="string" value="Male" class="fcall" /> Male
                <InputRadio id="Female" TValue="string" value="Female" class="fcall" /> Female
                <InputRadio id="Other" TValue="string" value="Other" class="fcall" /> Other
            </InputRadioGroup>
        </div>
    </div>
    
    <div class="FirstCall-group">


    </div>

    <!-- Notes -->
    <div class="FirstCall-group1">
        <div class="FirstCall-group1">
            <label for="Notes">Notes:</label>
            <InputTextArea id="Notes" class="fcall" @bind-Value="currentDeceased.Notes" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-submit">Save</button>
</EditForm>

<!-- Navigation Controls for Record Selection -->
<div class="navigation-controls">
    <button @onclick="PreviousRecord" class="btn btn-secondary">Previous</button>
    <button @onclick="NextRecord" class="btn btn-secondary">Next</button>
</div>

@if (showResults)
{
    <h3>SAVED RESULTS</h3>
    <ul>
        @foreach (var deceased in Deceased)
        {
            <li>
                <strong>@deceased.FirstName @deceased.LastName</strong><br />
                Middle Name: @deceased.MiddleName<br />
                Title: @deceased.Title<br />
                Suffix: @deceased.Suffix<br />
                Status: @deceased.Status<br />
                Contract Balance: @deceased.ContractBalance<br />
                Date of Death: @deceased.DoD?.ToString("yyyy-MM-dd")<br />
                Time of Death: @deceased.TimeOfDeath?.ToString("yyyy-MM-dd")<br />
                SSN: @deceased.SSN<br />
                Gender: @deceased.Gender<br />
                Maiden Name: @deceased.MaidenName<br />
                Alias: @deceased.Alias<br />
                Phone Number: @deceased.IPhoneNumber<br />
                Veteran Status: @deceased.Vet<br />
                War: @deceased.War<br />
                Informant: @deceased.InformantName<br />
                Informant Email: @deceased.InformantEmail<br />
                Info Notified: @deceased.InfoNotified?.ToString("yyyy-MM-dd")<br />
                Notes: @deceased.Notes<br />
            </li>
        }
    </ul>
}

@code {
    private List<RESTDB.Models.Deceased> Deceased = new List<RESTDB.Models.Deceased>();
    private RESTDB.Models.Deceased currentDeceased = new RESTDB.Models.Deceased();
    private bool showResults = false; // Flag to control visibility of saved results
    private int currentRecordIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        Deceased = await Context.Deceased.ToListAsync();
        if (Deceased.Any())
        {
            currentDeceased = Deceased.First();
        }
    }

    private int GetNextClientID()
    {
        var lastDeceased = Context.Deceased.OrderByDescending(d => d.ClientID).FirstOrDefault();
        return lastDeceased?.ClientID + 1 ?? 1;
    }

    private async Task SaveRecord()
    {
        if (string.IsNullOrEmpty(currentDeceased.FirstName) || string.IsNullOrEmpty(currentDeceased.LastName))
        {
            Console.WriteLine($"Invalid data: First Name = '{currentDeceased.FirstName}', Last Name = '{currentDeceased.LastName}' are required.");
            return;
        }
        if (currentDeceased.ClientID == 0)
        {
            currentDeceased.ClientID = GetNextClientID();
        }

        Context.Deceased.Update(currentDeceased); // Update the existing record
        await Context.SaveChangesAsync();

        Deceased = await Context.Deceased.ToListAsync();
        showResults = true; // After saving, show results
    }

    private void PreviousRecord()
    {
        if (currentRecordIndex > 0)
        {
            currentRecordIndex--;
            currentDeceased = Deceased[currentRecordIndex];
        }
    }

    private void NextRecord()
    {
        if (currentRecordIndex < Deceased.Count - 1)
        {
            currentRecordIndex++;
            currentDeceased = Deceased[currentRecordIndex];
        }
    }
}

@code {
    private string ssnValue = "";
    private string zipCode = "";
    private void Zip(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        var digits = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? []);

        if (digits.Length > 5)
            digits = digits[..5];
        
        zipCode = digits;
    }
    private void FormatSSN(ChangeEventArgs e)
    {
        string digits = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? []);

        if (digits.Length > 9)
            digits = digits.Substring(0, 9);

        if (digits.Length >= 5)
            ssnValue = $"{digits.Substring(0, 3)}-{digits.Substring(3, 2)}-{digits.Substring(5)}";
        else if (digits.Length >= 3)
            ssnValue = $"{digits.Substring(0, 3)}-{digits.Substring(3)}";
        else
            ssnValue = digits;
    }
}
