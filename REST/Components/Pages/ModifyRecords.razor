					oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
			</div>

			<!-- SSN -->
			<div class="FirstCall-group1">
				<label for="SSN">SSN:</label>
				<div class="SSN-input">
					<InputText id="SSNPart1" class="numcall1" maxlength="3" @bind-Value="SSNPart1" placeholder="###" />
					<span>-</span>
					<InputText id="SSNPart2" class="numcall2" maxlength="2" @bind-Value="SSNPart2" placeholder="##" />
					<span>-</span>
					<InputText id="SSNPart3" class="numcall3" maxlength="4" @bind-Value="SSNPart3" placeholder="####" />
				</div>
			</div>
			<!-- Maiden Name -->
			<div class="FirstCall-group1">
				<label for="MaidenName">Maiden Name:</label>
				<InputText id="MaidenName" class="fcall" @bind-Value="currentDeceased.MaidenName" />
			</div>
			<!-- Veteran Status -->
			<div class="FirstCall-group1">
				<label for="Vet">Veteran Status:</label>
				<InputText id="Vet" class="fcall" @bind-Value="currentDeceased.Vet" />
			</div>
			<!-- War -->
			<div class="FirstCall-group1">
				<label for="War">War Served:</label>
				<InputText id="War" class="fcall" @bind-Value="currentDeceased.War" />
			</div>
			<!-- Suffix -->
			<div class="suffix-container">
				<label for="suffix">Suffix:</label>
				<InputText id="suffix" class="fcall" @bind-Value="currentDeceased.Suffix" />
			</div>
			<!-- Gender -->
			<div class="gender-container">
				<label>Gender:</label>
				<InputSelect @bind-Value="currentDeceased.Gender" class="gender-group" TValue="string">
						<option value="Male">Male</option>
						<option value="Female">Female</option>
				</InputSelect>
			</div>
			<!-- Notes -->
			<div class="FirstCall-group1">
				<label for="Notes">Notes:</label>
				<InputTextArea id="Notes" class="fcall notes-field" @bind-Value="currentDeceased.Notes" />
			</div>
			<!-- Image Upload -->
			<div class="FirstCall-group1">
				<label for="ImageUpload">Upload Image:</label>
				<InputFile id="ImageUpload" OnChange="HandleImageUpload" class="fcall" />
			</div>
			@if (currentDeceased.Image != null)
			{
				<img src="@($"data:image/png;base64,{Convert.ToBase64String(currentDeceased.Image)}")" style="width: 20%; hieght: 20%;" alt="Uploaded Image" />
			}

		</div>
