@code {
	private List<Deceased> Deceased = new List<Deceased>();
	private Deceased editingDeceased = new Deceased();
	private Deceased existingDeceased = new Deceased();
	private string? PhonePart1 { get; set; }
	private string? PhonePart2 { get; set; }
	private string? PhonePart3 { get; set; }

	private string? SSNPart1 { get; set; }
	private string? SSNPart2 { get; set; }
	private string? SSNPart3 { get; set; }
	public string? errorMessage { get; set; }
	private string? placeholder { get; set; }

	// Tab logic
	private string selectedTab = "Primary Info";

	private void SelectTab(string tabName)
	{
		selectedTab = tabName;
	}

	protected override void OnInitialized() // This prevents direct URL access when no records exist.
	{
		if (UserState.ServiceID == "None") {NavigationManager.NavigateTo("Search Records");}
	}

	protected override async Task OnInitializedAsync()
	{
		if (UserState.ServiceID != "None")
		{
			var  existingDeceased = await Db.Deceased
				.Include(d => d.Airline)
				.Include(d => d.Buyer)
				.Include(d => d.CashAdvance)
				.Include(d => d.CauseOfDeath)
				.Include(d => d.ContainerShipping)
				.Include(d => d.Embalmer)
				.Include(d => d.FlagApplication)
				.Include(d => d.Military)
				.Include(d => d.MilitaryStint)
				.Include(d => d.Monument)
				.Include(d => d.ObituaryData)
				.Include(d => d.PlaceOfDeath)
				.Include(d => d.Products)
				.Include(d => d.ServiceContract)
				.Include(d => d.Services)
				.Include(d => d.Survivors)
				.Include(d => d.WarsServed)
				.FirstOrDefaultAsync(d => d.ServiceID == UserState.ServiceID);

			if (existingDeceased != null)
				editingDeceased = CloneDeceased(existingDeceased);
		}

		LoadDigits();
	}

