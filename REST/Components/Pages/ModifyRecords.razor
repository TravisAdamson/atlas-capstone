		<div class="FirstCallTop-group">
			<!-- Director -->
			<div class="FirstCall-group1">
				<label for="Director">Director</label>
				<InputSelect @bind-Value="edittingDeceased.Director" class="State-group" TValue="string">
						<option value="Denise Adamson">Denise Adamson</option>
						<option value="Jon Hoopert">Jon Hoopert</option>
						<option value="James Groesbeck">James Groesbeck</option>
						<option value="John Heim">John Heim</option>
				</InputSelect>
			</div>
			<!-- Case Status -->
			<div class="FirstCall-group1">
				<label for="Status">Case Status:</label>
				<InputText id="Status" class="fcall" @bind-Value="edittingDeceased.Status" />
			</div>
			<div class="ShowImage">
				@if (edittingDeceased.Image != null)
				{
					<img src="@($"data:image/png;base64,{Convert.ToBase64String(edittingDeceased.Image)}")" style="max-width: 260px; max-height: 258px; width: auto; height: auto; display: block; padding-bottom: 1rem;" alt="Uploaded Image" />
				}
			</div>
