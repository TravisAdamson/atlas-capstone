    padding-right: .25rem;
	padding-top: .25rem;
	margin: .5rem auto;
	background-color: rgb(187, 188, 188);
}

.Survivor-group {
		display: flex;
		flex-wrap: wrap;
        gap: 1rem;
	}

.Form-group {
		display: flex;
		flex-direction: column;
		margin-bottom: .5rem;
}

h5 {
    font-size: 1.7em;
    margin-bottom: 15px;
}

