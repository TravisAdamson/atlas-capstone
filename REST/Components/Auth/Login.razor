@page "/Login"
@using REST.Services
@using Microsoft.AspNetCore.Components
@inject UserManager<AppUser> UserManager
@inject NavigationManager NavigationManager
@inject SignInManager<AppUser> SignInManager
@inject UserState UserState
@layout _EmptyLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer


<EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="login-container"
        <div class="login-form">
            <h3>Login</h3>
            <div class="form-group">
                <label for="username" class="username">Username</label>
                <InputText id="username" class="form-control" @bind-Value="loginModel.UserName" />
            </div>

            <div class="form-group">
                <label for="password" class="password">Password</label>
                <InputText id="password" class="form-control" type="password" @bind-Value="loginModel.Password" />
            </div>

            <button type="submit" class="btn btn-primary">Login</button>
        </div>
    </div>
</EditForm>

@code {
	[SupplyParameterFromForm(FormName = "LoginForm")]
    private LoginModel loginModel { get; set; } = new LoginModel();

	protected override void OnInitialized() => loginModel ??= new();

    private async Task HandleLogin()
    {
		if (loginModel == null || loginModel.UserName == null || loginModel.Password == null)
		{
			Console.WriteLine("All fields are required");
			return;
		}
        else
		{
			var result = await SignInManager.PasswordSignInAsync(loginModel.UserName, loginModel.Password, false, false);

			if (result.Succeeded)
			{
				UserState.UserName = loginModel.UserName;
				NavigationManager.NavigateTo("/Home");  // Redirect to home page
			}
			else
			{
				// Handle login failure (show an error message)
				Console.WriteLine("Invalid login attempt.");
			}
		}
    }

    public class LoginModel
    {
		[Required]
        public string? UserName { get; set; }

		[Required]
		public string? Password { get; set; }
    }
}

<style>
    .login-container {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        width: 100vw;
        background-color: #f0f0f0;
    }

    .login-form {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 60vh;
        width: 40vh;
        padding-top: 1rem;
        border-radius: 5px;
        border: 2px solid #000000;
        background-color: #ffffff;
    }
    
    h3 {
        font-size: 2rem;
        margin-bottom: 2.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 0.5rem;
    }

    .username {
        text-align: start;
        width: 15rem;
    }

    .password {
        text-align: start;
        width: 15rem;
    }

    .form-control {
        width: 15rem;
        border: 1px solid #000000;
    }
    
    .btn-primary {
        background-color: #552f7a;
        border-color: #552f7a;
    }

    .btn-primary:hover {
        background-color: #3a0647;
        border-color: #3a0647;
    }
</style>