@page "/Login"
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager NavigationManager
@inject UserState UserState
@using Microsoft.AspNetCore.Components.Forms
@layout _EmptyLayout
@attribute [AllowAnonymous]

<h3>Login</h3>

<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="username">Username</label>
        <InputText id="username" class="form-control" @bind="loginModel.UserName" />
    </div>

    <div class="form-group">
        <label for="password">Password</label>
        <InputPassword id="password" class="form-control" @bind="loginModel.Password" />
    </div>

    <button type="submit" class="btn btn-primary">Login</button>
</EditForm>

@code {
    private LoginModel loginModel = new LoginModel();

    private async Task HandleLogin()
    {
        var result = await SignInManager.PasswordSignInAsync(loginModel.UserName, loginModel.Password, false, false);

        if (result.Succeeded)
        {
            NavigationManager.NavigateTo("/Home");  // Redirect to home page
        }
        else
        {
            // Handle login failure (show an error message)
            Console.WriteLine("Invalid login attempt.");
        }
    }

    public class LoginModel
    {
        public string UserName { get; set; }
        public string Password { get; set; }
    }
}
