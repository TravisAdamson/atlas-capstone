@inherits LayoutComponentBase

<!-- Header -->
<header class="top-header">
    <div class="header-content">
        <span>REST</span>
    </div>
    <button class="logout">
        Logout
    </button>
</header>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
