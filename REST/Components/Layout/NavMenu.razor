@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Routing

<div class="nav-bar-object">
	<div class="nav-item px-3">
		<NavLink class="nav-link" href="" Match="NavLinkMatch.All">
			<span class="nav-icon bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
			<span class="nav-text">Home</span>
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="First Call">
            <span class="nav-icon bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>
            <span class="nav-text">First Call</span>
        </NavLink>
    </div>
	<div class="nav-item px-3 @(isModifiedOpen ? "open" : "")" href="Search Records">
		<button class="nav-link btn" style="font-size: 14.4px;"
				@onclick="ToggleModified">
			<NavLink class="nav-link" href="Search Records" aria-current="page">
				<span class="nav-icon bi bi-wrench-fill-nav-menu" aria-hidden="true"></span>
				<span class="nav-text">Modify Records</span>
				<span class="ms-auto @(isModifiedOpen ? "bi-caret-up-fill" : "bi-caret-down-fill")"></span>
			</NavLink>
		</button>

		@if (isModifiedOpen)
		{
			<ul class="nav flex-column ms-4">
				<li class="nav-item">
					<NavLink class="nav-link" href="Place of Death">• Place of Death</NavLink>
				</li>
				<li class="nav-item">
					<NavLink class="nav-link" href="Military">• Military</NavLink>
				</li>
				<li class="nav-item">
					<NavLink class="nav-link" href="Contract">• Contract</NavLink>
				</li>
				<li class="nav-item">
					<NavLink class="nav-link" href="Survivor">• Survivor</NavLink>
				</li>
				<li class="nav-item">
					<NavLink class="nav-link" href="Embalmer">• Embalmer</NavLink>
				</li>
				<li class="nav-item">
					<NavLink class="nav-link" href="Obituary">• Obituary</NavLink>
				</li>
			</ul>
		}
	</div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="Search Records">
            <span class="nav-icon bi bi-search-fill-nav-menu" aria-hidden="true"></span>
            <span class="nav-text">Search Records</span>
        </NavLink>
    </div>
</div>

@code {
    private bool isModifiedOpen;
    private void ToggleModified()

    {
        isModifiedOpen = !isModifiedOpen;
    }
}
