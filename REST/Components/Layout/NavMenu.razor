@rendermode InteractiveServer

<div class="nav-bar-object">
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="nav-icon bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
            <span class="nav-text">Home</span>
        </NavLink>
    </div>

<div class="nav-item px-3 @(isFirstCallOpen ? "open" : "")">
    <button class="nav-link btn d-flex align-items-center w-100 text-start"
            @onclick="ToggleFirstCall">
        <span class="me-2 bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>
        <span class="nav-text">First Call</span>
        <span class="ms-auto @(isFirstCallOpen ? "bi-caret-up-fill" : "bi-caret-down-fill")"></span>
    </button>

    @if (isFirstCallOpen)
    {
        <ul class="nav flex-column ms-4">
            <li class="nav-item">
                <NavLink class="nav-link" href="/firstcall/option1">Option 1</NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/firstcall/option2">Option 2</NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/firstcall/option3">Option 3</NavLink>
            </li>
        </ul>
    }
</div>

@code {
    private void ToggleFirstCall()
    {
        isFirstCallOpen = !isFirstCallOpen;
    }
}
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="Modify Records">
            <span class="nav-icon bi bi-wrench-fill-nav-menu" aria-hidden="true"></span>
            <span class="nav-text">Modify Records</span>
        </NavLink>
    </div>

    <div class="nav-item px-3">
        <NavLink class="nav-link" href="Search Records">
            <span class="nav-icon bi bi-search-fill-nav-menu" aria-hidden="true"></span>
            <span class="nav-text">Search Records</span>
        </NavLink>
    </div>

    <div class="nav-item px-3">
        <NavLink class="nav-link" href="Contract">
            <span class="nav-icon bi bi-card-text-fill-nav-menu" aria-hidden="true"></span>
            <span class="nav-text">Contract</span>
        </NavLink>
    </div>
</div>

