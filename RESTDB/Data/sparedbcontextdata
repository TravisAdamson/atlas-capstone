using Microsoft.EntityFrameworkCore;

public class FuneralDbContext : DbContext
{
    public DbSet<CashAdvance> CashAdvances { get; set; }
    public DbSet<Obituary> Obituaries { get; set; }
    public DbSet<Survivor> Survivors { get; set; }
    public DbSet<Buyer> Buyers { get; set; }
    public DbSet<SalesContract> SalesContracts { get; set; }
    public DbSet<Service> Services { get; set; }
    public DbSet<PlaceOfDeath> PlacesOfDeath { get; set; }
    public DbSet<Shipping> Shippings { get; set; }
    public DbSet<Airline> Airlines { get; set; }
    public DbSet<PersonalAffect> PersonalAffects { get; set; }
    public DbSet<Military> Militaries { get; set; }
    public DbSet<FlagApplication> FlagApplications { get; set; }
    public DbSet<Monument> Monuments { get; set; }
    public DbSet<PresidentialMemorialCertificate> PresidentialMemorialCertificates { get; set; }
    public DbSet<WarsServed> WarsServeds { get; set; }
    public DbSet<MilitaryStint> MilitaryStints { get; set; }
    public DbSet<BurialBenefitsApplication> BurialBenefitsApplications { get; set; }
    public DbSet<AgencyCertification> AgencyCertifications { get; set; }

    // Connection string and other DB settings should be configured here.
    protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)
    {
        optionsBuilder.UseSqlServer("Your_Connection_String");
    }
}
